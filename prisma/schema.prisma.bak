generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                           String                    @id @default(uuid())
  phone                        String                    @unique
  role                         UserRole                  @default(CONSUMER)
  name                         String?
  email                        String?                   @unique
  password                     String?
  avatar                       String?
  vehicleType                  VehicleType?
  licensePlate                 String?
  isOnline                     Boolean                   @default(false)
  currentLocation              Json?
  isActive                     Boolean                   @default(true)
  isVerified                   Boolean                   @default(false)
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt
  lastActive                   DateTime                  @default(now())
  countryCode                  String                    @default("+91")
  bankInfo                     Json?
  emergencyContact             Json?
  region                       String?
  warehouseId                  String?
  dob                          DateTime?
  gender                       String?
  referralCode                 String?
  inviteRefCode                String?                   @unique
  bonusType                    String?
  lastLoginAt                  DateTime?
  alternatePhone               String?
  fatherOrSpouseName           String?
  maritalStatus                String?
  nationality                  String?
  surname                      String?
  lastHeartbeatAt              DateTime?
  lastBatteryPercent           Int?
  lastBatteryAlertKey          String?
  approvalStatus               ApprovalStatus            @default(PENDING)
  assignedVehicleId            String?
  shiftId                      String?
  attendanceEnabled            Boolean                   @default(true)
  baseSalary                   Float?                    @default(12000)
  customRoleId                 String?
  dailyTarget                  Float?                    @default(10000)
  kycStatus                    String                    @default("PENDING")
  vgeType                      String                    @default("EMPLOYEE")
  deliveryPreference           String?
  dietaryPreference            String?
  targetActions                ActivityLog[]             @relation("TargetActions")
  actions                      ActivityLog[]             @relation("UserActions")
  addresses                    Address[]
  agentCashCollections         AgentCashCollection[]
  agentWithdrawals             AgentWithdrawal[]
  assetAssignments             AssetAssignment[]
  assetIssues                  AssetIssue[]
  assetRequests                AssetRequest[]            @relation("UserAssetRequests")
  attendances                  Attendance[]
  bankDeposits                 BankDeposit[]
  carts                        Cart[]
  cashSessions                 CashSession[]
  cashTransfers                CashTransfer[]
  receivedChats                Chat[]                    @relation("ChatReceiver")
  sentChats                    Chat[]                    @relation("ChatSender")
  closingCash                  ClosingCash[]
  ConsumerSubscription         ConsumerSubscription[]
  couponRedemptions            CouponRedemption[]
  CycleCount                   CycleCount[]
  dailySummaries               DailyCashSummary[]        @relation("UserDailyCashSummary")
  deductionsApplied            DamageDeduction[]         @relation("DeductionApplier")
  deductionsReceived           DamageDeduction[]         @relation("DeductionTarget")
  damageReports                DamageEntry[]             @relation("DamageReporter")
  damageReviews                DamageEntry[]             @relation("DamageReviewer")
  deliveries                   Delivery[]                @relation("DeliveryAgent")
  agentBank                    DeliveryAgentBank?
  deliveryAgentDocuments       DeliveryAgentDocument[]
  agentEducations              DeliveryAgentEducation[]
  agentExperiences             DeliveryAgentExperience[]
  deliveryAssignments          DeliveryAssignment[]
  deliveryAttemptsAsAgent      DeliveryAttempt[]         @relation("DeliveryAttemptAgent")
  deliveryLocationHistory      DeliveryLocationHistory[] @relation("DeliveryLocationHistoryAgent")
  deviceMetadata               DeviceMetadata[]
  devices                      DeviceToken[]
  expenses                     Expense[]
  fulfillmentAssignments       FulfillmentAssignment[]
  GoodsReceipt                 GoodsReceipt[]
  inventoryApprovedCycleCounts InventoryCycleCount[]     @relation("UserApprovedCycleCounts")
  inventoryCycleCounts         InventoryCycleCount[]     @relation("UserCycleCounts")
  inventoryDamageEntries       InventoryDamageEntry[]    @relation("UserDamageEntries")
  inventoryLocations           InventoryLocation[]       @relation("UserLocations")
  inventoryMovements           InventoryMovement[]       @relation("UserMovements")
  approvedRefillRequests       InventoryRefillRequest[]  @relation("RefillApprover")
  refillRequests               InventoryRefillRequest[]  @relation("RefillRequester")
  inventoryReservations        InventoryReservation[]    @relation("UserReservations")
  lateEntries                  LateEntry[]
  approvedExceptions           LateEntryException[]      @relation("ApprovedBy")
  lateExceptions               LateEntryException[]      @relation("UserExceptions")
  leaveBalances                LeaveBalance[]
  locationCheckIns             LocationCheckIn[]
  locationLogs                 LocationLog[]
  media                        Media[]
  shiftsAsDriver               MobileStoreShift[]        @relation("ShiftDriver")
  shiftsAsSalesStaff           MobileStoreShift[]        @relation("ShiftSalesStaff")
  notifications                Notification[]
  openingCash                  OpeningCash[]
  agentOrders                  Order[]                   @relation("AgentOrders")
  consumerOrders               Order[]                   @relation("ConsumerOrders")
  deliveryBoyRatings           OrderRating[]             @relation("DeliveryBoyRatings")
  orderRatings                 OrderRating[]             @relation("UserOrderRatings")
  trackingEventsAsAgent        OrderTrackingEvent[]      @relation("OrderTrackingEventAgent")
  ratings                      Rating[]
  approvedRefills              RefillRequest[]           @relation("ApprovedRefills")
  vsmsRefillRequests           RefillRequest[]
  returns                      Return[]
  returnRequests               ReturnRequest[]
  routeAssignments             RouteAssignment[]
  routeExecutions              RouteExecution[]
  routeSchedules               RouteSchedule[]
  safeTransactions             SafeTransaction[]
  SavedPaymentMethod           SavedPaymentMethod[]
  sessions                     Session[]
  shiftLogs                    ShiftLog[]
  socketSessions               SocketSession[]
  stockAdjusts                 StockAdjust[]
  stockAudits                  StockAudit[]
  stockTransactions            StockTransaction[]        @relation("UserStockTransactions")
  StockTransfer                StockTransfer[]
  store                        Store?
  closedRegisters              StoreCashRegister[]       @relation("ClosedRegisters")
  openedRegisters              StoreCashRegister[]       @relation("OpenedRegisters")
  storeDeposits                StoreDeposit[]
  supplier                     Supplier?
  assignedVehicle              Vehicle?                  @relation("UserVehicle", fields: [assignedVehicleId], references: [id])
  shift                        Shift?                    @relation(fields: [shiftId], references: [id])
  Warehouse                    Warehouse?                @relation(fields: [warehouseId], references: [id])
  userCoupons                  UserCoupon[]
  documents                    UserDocument[]
  vehicles                     VehicleInfo[]
  vehicleDamageReports         VehiclePhysicalDamage[]   @relation("VehicleDamageReporter")
  vehicleTrips                 VehicleTrip[]
  vendorSetting                VendorSetting?
  dailyPerformance             VgeDailyPerformance[]     @relation("UserDailyPerformance")
  monthlySummaries             VgeMonthlySummary[]       @relation("UserMonthlySummary")
  villageActivities            VillageActivity[]
  wishlist                     Wishlist?                 @relation("UserWishlists")

  @@index([phone, role])
  @@index([role, isActive, isOnline])
}

model DeviceToken {
  id          String   @id @default(uuid())
  deviceToken String   @unique
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  fcmToken    String?  @unique
  platform    String?
  appVersion  String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DeviceMetadata {
  id                  String    @id @default(uuid())
  userId              String
  deviceId            String
  deviceToken         String?
  platform            String?
  deviceModel         String?
  deviceBrand         String?
  deviceManufacturer  String?
  deviceName          String?
  osName              String?
  osVersion           String?
  appVersion          String?
  buildNumber         String?
  sdkVersion          String?
  networkType         String?
  ipAddress           String?
  language            String?
  timezone            String?
  country             String?
  notificationEnabled Boolean?
  isEmulator          Boolean?
  isRooted            Boolean?
  clientUpdatedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceToken])
  @@index([updatedAt])
}

model VehicleInfo {
  id                   String              @id @default(uuid())
  agentId              String
  vehicleType          String
  brand                String
  model                String
  year                 Int
  color                String
  registrationNumber   String              @unique
  engineNumber         String              @unique
  chassisNumber        String              @unique
  insuranceProvider    String?
  policyNumber         String?
  insuranceExpiry      DateTime?
  drivingLicenseNumber String?
  licenseExpiry        DateTime?
  rcExpiry             DateTime?
  pucExpiry            DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  inventoryLocations   InventoryLocation[]
  agent                User                @relation(fields: [agentId], references: [id])
  vehicleInventory     VehicleInventory[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String?  @unique
  deviceId  String?
  fcmToken  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  otp       String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Address {
  id          String      @id @default(uuid())
  userId      String
  label       String?
  line1       String
  line2       String?
  city        String
  state       String
  pincode     String
  isDefault   Boolean     @default(false)
  location    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  addressType AddressType @default(PERMANENT)
  mandal      String?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([userId, isDefault])
  @@index([pincode])
}

model Warehouse {
  id                         String                      @id @default(uuid())
  name                       String
  code                       String                      @unique
  location                   Json
  address                    String
  phone                      String?
  isActive                   Boolean                     @default(true)
  opensAt                    String?
  closesAt                   String?
  servicePincodes            String[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  state                      String?
  isPickupStore              Boolean                     @default(false)
  pickupTimeSlots            Json?
  onboardingStep             Int                         @default(1)
  onboardingStatus           OnboardingStatus            @default(IN_PROGRESS)
  resumeToken                String?
  resumeTokenExp             DateTime?
  fatherOrSpouseName         String?
  alternateMobileNumber      String?
  maritalStatus              String?
  educationQualification     String?
  communicationAddress       Json?
  sameAsPermanent            Boolean                     @default(false)
  approvalStatus             ApprovalStatus              @default(PENDING)
  sirName                    String?
  imageUrl                   String?
  rejectionReason            String?
  city                       String?
  clusterId                  String?
  contactNumber              String?
  managerName                String?
  pincode                    String?
  activityLogs               ActivityLog[]
  assets                     Asset[]
  assetCategories            AssetCategory[]
  attendances                Attendance[]
  bankDeposits               BankDeposit[]
  banners                    Banner[]
  businessSettings           BusinessSettings?
  campaigns                  Campaign[]
  carts                      Cart[]
  cashSessions               CashSession[]
  cashTransfers              CashTransfer[]
  closingCash                ClosingCash[]
  coupons                    Coupon[]
  customers                  Customer[]
  CycleCount                 CycleCount[]
  dailySummaries             DailyCashSummary[]
  dailyCoverages             DailyCoverage[]
  damageDeductions           DamageDeduction[]
  damageEntries              DamageEntry[]
  deliveryAssignments        DeliveryAssignment[]
  deliveryChargeRules        DeliveryChargeRule[]
  deliverySlots              DeliverySlot[]
  expenses                   Expense[]
  inventoryLocations         InventoryLocation[]
  lateEntries                LateEntry[]
  lateConfigs                LateEntryConfig[]
  locationCheckIns           LocationCheckIn[]
  mobileStores               MobileStore[]
  openingCash                OpeningCash[]
  allocatedOrders            Order[]                     @relation("OrderAllocatedWarehouse")
  pickupOrders               Order[]                     @relation("PickupStore")
  orders                     Order[]
  PackingTray                PackingTray[]
  pickupSlots                PickupSlot[]
  products                   Product[]
  ProductLocation            ProductLocation[]
  Rack                       Rack[]
  refillItems                RefillItem[]
  refillRequests             RefillRequest[]
  routes                     Route[]
  routeMaps                  RouteMap[]
  safeTransactions           SafeTransaction[]
  scheduledDeliverySlots     ScheduledDeliverySlot[]
  shiftLogs                  ShiftLog[]
  StockAdjust                StockAdjust[]
  stockAudits                StockAudit[]
  stockTransactions          StockTransaction[]
  stores                     Store[]
  storeCashRegisters         StoreCashRegister[]
  storeDeposits              StoreDeposit[]
  User                       User[]
  variantInventory           VariantInventory[]
  vehicles                   Vehicle[]
  vehicleStocks              VehicleStock[]
  dailyPerformance           VgeDailyPerformance[]
  incentiveConfigs           VgeIncentiveConfig[]
  monthlySummaries           VgeMonthlySummary[]
  villages                   Village[]
  cluster                    Cluster?                    @relation(fields: [clusterId], references: [id])
  warehouseAssets            WarehouseAsset[]
  warehouseAudits            WarehouseAudit[]
  warehouseBusiness          WarehouseBusiness[]
  warehouseBusinessDocuments WarehouseBusinessDocument[]
  warehouseCapacity          WarehouseCapacity?
  warehouseCategories        WarehouseCategory[]
  deliveryBlackouts          WarehouseDeliveryBlackout[]
  warehouseDeliverySetting   WarehouseDeliverySetting?
  warehouseDocumentFiles     WarehouseDocumentFile[]
  warehouseEmployees         WarehouseEmployee[]
  warehouseLocations         WarehouseLocation[]
  warehouseReturns           WarehouseReturn[]
  warehouseSubCategories     WarehouseSubCategory[]
  warehouseTransfers         WarehouseTransfer[]
  warehouseZones             WarehouseZone[]

  @@index([isActive])
  @@index([servicePincodes])
  @@index([isPickupStore])
}

/// Global default delivery types; warehouses/partners override via WarehouseDeliverySetting.
model MasterDeliverySetting {
  id                 String       @id @default(uuid())
  type               DeliveryType @unique
  label              String
  isEnabledByDefault Boolean      @default(true)
  defaultCharge      Decimal      @db.Decimal(10, 2)
  displayOrder       Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([type])
}

/// Express charge: use expressDeliveryCharge when set, else defaultDeliveryCharge (express fallback).
model WarehouseDeliverySetting {
  id                       String    @id @default(uuid())
  warehouseId              String    @unique
  expressSettingsEnabled   Boolean   @default(false)
  selfPickupEnabled        Boolean   @default(false)
  scheduledDeliveryEnabled Boolean   @default(false)
  defaultDeliveryCharge    Decimal?  @db.Decimal(10, 2)
  scheduledDeliveryCharge  Decimal?  @db.Decimal(10, 2)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  expressDeliveryCharge    Decimal?  @db.Decimal(10, 2)
  warehouse                Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
}

model RouteMap {
  id                     String                  @id @default(uuid())
  warehouseId            String
  area                   String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deliverySlots          DeliverySlot[]
  orders                 Order[]
  warehouse              Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  routeMapPincodes       RouteMapPincode[]
  scheduledDeliverySlots ScheduledDeliverySlot[]

  @@unique([warehouseId, area])
  @@index([warehouseId])
}

model RouteMapPincode {
  id         String   @id @default(uuid())
  routeMapId String
  pincode    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  routeMap   RouteMap @relation(fields: [routeMapId], references: [id], onDelete: Cascade)

  @@unique([routeMapId, pincode])
  @@index([pincode])
  @@index([routeMapId])
}

model ScheduledDeliverySlot {
  id            String                   @id @default(uuid())
  warehouseId   String
  routeMapId    String
  slotDate      DateTime                 @db.Date
  startTime     String
  endTime       String
  ordersPerSlot Int
  isRepeat      Boolean                  @default(false)
  repeatType    ScheduledSlotRepeatType? @default(ONCE)
  customDays    String[]                 @default([])
  isActive      Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  orders        Order[]
  routeMap      RouteMap                 @relation(fields: [routeMapId], references: [id], onDelete: Cascade)
  warehouse     Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, routeMapId, slotDate, startTime, endTime])
  @@index([warehouseId, slotDate])
  @@index([routeMapId])
  @@index([slotDate])
}

model Supplier {
  id               String          @id @default(uuid())
  userId           String          @unique
  companyName      String
  gstin            String?
  businessAddress  Json
  licenseDocs      Json?
  operatingHours   Json?
  deliveryOptions  Json?
  GoodsReceipt     GoodsReceipt[]
  user             User            @relation(fields: [userId], references: [id])
  masterProducts   MasterProduct[] @relation("MasterSupplierProducts")
  suppliedProducts Product[]       @relation("SupplierProducts")
}

model Product {
  id                           String                         @id @default(uuid())
  name                         String
  slug                         String?
  description                  String?
  shortDescription             String?
  images                       String[]
  tags                         String[]
  brandId                      String?                        @db.Uuid
  categoryId                   String                         @db.Uuid
  subCategoryId                String?                        @db.Uuid
  productType                  String?
  inventoryType                String?
  price                        Float
  mrp                          Float?
  discountType                 String?
  discountValue                Float?
  finalPrice                   Float?
  costPrice                    Float?
  taxRate                      Float?                         @default(0)
  unitType                     String?
  unit                         String
  measurement                  String?
  warehouseId                  String?
  stock                        Int                            @default(0)
  threshold                    Int                            @default(5)
  minOrderQty                  Int?
  maxOrderQty                  Int?
  isActive                     Boolean                        @default(true)
  isFeatured                   Boolean                        @default(false)
  status                       ProductStatus                  @default(PENDING)
  variantName                  String?
  sku                          String?
  barcode                      String?
  variantStatus                Boolean                        @default(true)
  weight                       Float                          @default(0)
  metaTitle                    String?
  metaKeywords                 String?
  metaDescription              String?
  schemaMarkup                 String?
  manufacturer                 String?
  madeIn                       String?
  fssaiLicNo                   String?
  isReturnable                 Boolean                        @default(false)
  isCancelable                 Boolean                        @default(false)
  isCodAllowed                 Boolean                        @default(false)
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  masterProductId              String?                        @db.Uuid
  cancellableOrderStatuses     String[]                       @default([])
  returnableDays               Int?
  cartItems                    CartItem[]
  ConsumerSubscription         ConsumerSubscription[]
  cycleCountItems              CycleCountItem[]
  vsmsDamageEntries            DamageEntry[]
  fulfillmentOrderItems        FulfillmentOrderItem[]
  GoodsReceiptItem             GoodsReceiptItem[]
  inventoryBatches             InventoryBatch[]
  damageEntries                InventoryDamageEntry[]
  inventoryLedgers             InventoryLedger[]
  inventoryMovements           InventoryMovement[]
  reservations                 InventoryReservation[]
  orderItems                   OrderItem[]
  ProcurementGoodsReceiptItem  ProcurementGoodsReceiptItem[]
  ProcurementStockLedger       ProcurementStockLedger[]
  ProcurementStockTransferItem ProcurementStockTransferItem[]
  brand                        Brand?                         @relation(fields: [brandId], references: [id])
  category                     Category                       @relation(fields: [categoryId], references: [id])
  masterProduct                MasterProduct?                 @relation(fields: [masterProductId], references: [id])
  subCategory                  SubCategory?                   @relation(fields: [subCategoryId], references: [id])
  warehouse                    Warehouse?                     @relation(fields: [warehouseId], references: [id])
  ProductLocation              ProductLocation[]
  prices                       ProductPrice[]
  ProductTierPrice             ProductTierPrice[]
  variants                     ProductVariant[]
  PurchaseInvoiceItem          PurchaseInvoiceItem[]
  PurchaseOrderItem            PurchaseOrderItem[]
  PurchaseRequisitionItem      PurchaseRequisitionItem[]
  ratings                      Rating[]
  refillItems                  RefillItem[]
  refillRequestItems           RefillRequestItem[]
  returnItems                  ReturnItem[]
  sales                        Sales[]
  StockAdjust                  StockAdjust[]
  auditItems                   StockAuditItem[]
  stockLedgers                 StockLedger[]
  stockTransactions            StockTransaction[]
  StockTransferItem            StockTransferItem[]
  unifiedInventory             UnifiedInventory[]
  vehicleInventory             VehicleInventory[]
  vehicleStocks                VehicleStock[]
  VendorItemMapping            VendorItemMapping[]
  demandForecasts              VillageDemandForecast[]
  supplier                     Supplier[]                     @relation("SupplierProducts")
  bundleItems                  BundleItem[]


  @@unique([warehouseId, slug])
  @@index([name, warehouseId])
  @@index([categoryId, isActive])
  @@index([brandId, isActive])
  @@index([warehouseId, stock])
  @@index([isActive, isFeatured])
  @@index([sku])
  @@index([barcode])
  @@index([status, isActive])
  @@index([isReturnable, isActive])
  @@index([isCodAllowed, isActive])
  @@index([masterProductId])
}

model Rating {
  id        String   @id @default(uuid())
  rating    Float
  review    String?
  userId    String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Sales {
  id        String   @id @default(uuid())
  productId String
  quantity  Int
  total     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id                String     @id @default(uuid())
  userId            String
  updatedAt         DateTime   @updatedAt
  appliedCouponCode String?
  appliedCouponId   String?    @db.Uuid
  cgst              Float      @default(0)
  igst              Float      @default(0)
  sgst              Float      @default(0)
  taxAmount         Float      @default(0)
  taxableAmount     Float      @default(0)
  expiresAt         DateTime?
  warehouseId       String
  appliedCoupon     Coupon?    @relation(fields: [appliedCouponId], references: [id])
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse         Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items             CartItem[]

  @@unique([userId, warehouseId])
  @@index([appliedCouponId])
  @@index([userId])
  @@index([warehouseId])
}

model CartItem {
  id               String          @id @default(uuid())
  cartId           String
  productId        String
  productVariantId String?
  bundleId         String?
  quantity         Int             @default(1)
  addedAt          DateTime        @default(now())
  priceUpdatedAt   DateTime?
  snapshotPrice    Float?
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@unique([cartId, productId, productVariantId])
  @@index([cartId])
  @@index([productVariantId])
}

model Order {
  id                       String                    @id @default(uuid())
  orderNumber              String                    @unique
  addressId                String?
  warehouseId              String?
  status                   OrderStatus               @default(PENDING)
  totalAmount              Float
  deliveryCharge           Float                     @default(0)
  discount                 Float                     @default(0)
  deliverySlot             String?
  deliverySlotId           String?
  deliveryDate             DateTime?
  specialInstructions      String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  confirmedAt              DateTime?
  agentId                  String?
  otp                      String?
  consumerId               String
  couponCode               String?
  couponDiscount           Float?
  couponId                 String?                   @db.Uuid
  cancellationFee          Float                     @default(0)
  cancellationReason       String?
  cancelledAt              DateTime?
  cancelledBy              String?
  cgst                     Float                     @default(0)
  igst                     Float                     @default(0)
  sgst                     Float                     @default(0)
  taxAmount                Float                     @default(0)
  taxableAmount            Float                     @default(0)
  deliveryDistance         Float?
  deliveryType             DeliveryType?
  fastDeliveryETA          Int?
  pickupStoreId            String?
  pickupTimeSlot           String?
  assignedAt               DateTime?
  pickedUpAt               DateTime?
  deliveredAt              DateTime?
  failureReason            String?
  otpExpiresAt             DateTime?
  pickupSlotId             String?
  routeMapId               String?
  scheduledSlotId          String?
  cartType                 CartType                  @default(SINGLE)
  assignmentDueAt          DateTime?
  assignmentAcknowledgedAt DateTime?
  customerId               String?
  routeId                  String?
  vehicleId                String?
  paymentMode              PaymentMode?
  cashAmount               Float?                    @default(0)
  upiAmount                Float?                    @default(0)
  fulfillmentType          FulfillmentType           @default(HOME_DELIVERY)
  mobileStoreId            String?
  orderType                OrderType                 @default(ONLINE)
  sourceOrderId            String?
  paymentStatus            String                    @default("PENDING")
  paymentMethod            String?
  transactionId            String?
  allocatedWarehouseId     String?
  allocatedStoreId         String?
  acceptedByShopkeeperAt   DateTime?
  allocationAttempts       Int?                      @default(0)
  allocationStartedAt      DateTime?
  allocationStatus         String?                   @default("Pending")
  allocationTimeoutMinutes Int?                      @default(5)
  assignedShopkeeperId     String?
  packerId                 String?
  packingCompletedAt       DateTime?
  packingStartedAt         DateTime?
  pickerId                 String?
  pickingCompletedAt       DateTime?
  pickingStartedAt         DateTime?
  priority                 String?                   @default("MEDIUM")
  shopkeeperAcceptedAt     DateTime?
  slaBreach                Boolean                   @default(false)
  slaMinutes               Int?                      @default(30)
  trayNumber               String?
  agentCashCollections     AgentCashCollection[]
  chats                    Chat[]
  couponRedemptions        CouponRedemption[]
  delivery                 Delivery?
  deliveryAssignment       DeliveryAssignment?
  deliveryAttempts         DeliveryAttempt[]
  deliveryLocationHistory  DeliveryLocationHistory[]
  fulfillmentOrders        FulfillmentOrder[]
  inventoryReservations    InventoryReservation[]
  address                  Address?                  @relation(fields: [addressId], references: [id])
  agent                    User?                     @relation("AgentOrders", fields: [agentId], references: [id])
  allocatedStore           Store?                    @relation("OrderAllocatedStore", fields: [allocatedStoreId], references: [id])
  allocatedWarehouse       Warehouse?                @relation("OrderAllocatedWarehouse", fields: [allocatedWarehouseId], references: [id])
  assignedShopkeeper       Shopkeeper?               @relation("ShopkeeperOrders", fields: [assignedShopkeeperId], references: [id])
  consumer                 User                      @relation("ConsumerOrders", fields: [consumerId], references: [id])
  coupon                   Coupon?                   @relation(fields: [couponId], references: [id])
  customer                 Customer?                 @relation(fields: [customerId], references: [id])
  deliverySlotRef          DeliverySlot?             @relation(fields: [deliverySlotId], references: [id])
  mobileStore              MobileStore?              @relation(fields: [mobileStoreId], references: [id])
  pickupSlotRef            PickupSlot?               @relation(fields: [pickupSlotId], references: [id])
  pickupStore              Warehouse?                @relation("PickupStore", fields: [pickupStoreId], references: [id])
  route                    Route?                    @relation(fields: [routeId], references: [id])
  routeMap                 RouteMap?                 @relation(fields: [routeMapId], references: [id])
  scheduledSlotRef         ScheduledDeliverySlot?    @relation(fields: [scheduledSlotId], references: [id])
  vehicle                  Vehicle?                  @relation(fields: [vehicleId], references: [id])
  warehouse                Warehouse?                @relation(fields: [warehouseId], references: [id])
  orderCancellation        OrderCancellation?
  items                    OrderItem[]
  modifications            OrderModification[]
  orderOtps                OrderOtp[]
  orderRatings             OrderRating[]
  orderReturnHistory       OrderReturnHistory[]
  statusHistory            OrderStatusHistory[]
  trackingEvents           OrderTrackingEvent[]
  packingTrays             PackingTray[]             @relation("TrayOrder")
  payment                  Payment?
  paymentTransactions      PaymentTransaction[]
  refundTransactions       RefundTransaction[]
  returns                  Return[]
  returnRequests           ReturnRequest[]
  riskAssessment           RiskAssessment?
  settlements              Settlement[]
  slaLogs                  SlaLog[]

  @@index([agentId, status])
  @@index([consumerId, status])
  @@index([consumerId, createdAt])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([couponCode])
  @@index([deliverySlotId])
  @@index([cartType])
  @@index([warehouseId, deliveryDate, deliverySlot])
  @@index([customerId])
}

/// Fulfillment OTP (pickup vs delivery). Plain OTP is never stored; only otpHash.
model OrderOtp {
  id          String       @id @default(uuid())
  orderId     String
  type        OrderOtpType
  otpHash     String
  expiresAt   DateTime
  attempts    Int          @default(0)
  resendCount Int          @default(0)
  lastSentAt  DateTime     @default(now())
  isVerified  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, type, isVerified])
}

model OrderItem {
  id                 String          @id @default(uuid())
  orderId            String
  productId          String
  productVariantId   String?
  quantity           Int
  unit               StandardUnits   @default(PIECE)
  unitPrice          Float
  totalPrice         Float
  discount           Float           @default(0)
  hsnCode            String?
  mrp                Float?
  productImage       String?
  productName        String?
  taxAmount          Float           @default(0)
  cgst               Float           @default(0)
  igst               Float           @default(0)
  sgst               Float           @default(0)
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledBy        String?
  isCancelled        Boolean         @default(false)
  isPicked           Boolean         @default(false)
  isRejected         Boolean         @default(false)
  isVerified         Boolean         @default(false)
  pickedQty          Int             @default(0)
  rejectReason       String?
  rejectRemarks      String?
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [productId], references: [id])
  productVariant     ProductVariant? @relation(fields: [productVariantId], references: [id])
  returns            Return[]

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
  @@index([isCancelled])
  @@index([unit])
}

model Payment {
  id                 String                 @id @default(uuid())
  orderId            String                 @unique
  method             PaymentMethod
  amount             Float
  status             PaymentStatus          @default(PENDING)
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?
  codCollected       Boolean                @default(false)
  codAmount          Float?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  failedAt           DateTime?
  razorpayRefundId   String?
  refundedAt         DateTime?
  order              Order                  @relation(fields: [orderId], references: [id])
  statusHistory      PaymentStatusHistory[]
  refundTransactions RefundTransaction[]

  @@index([status, method])
  @@index([createdAt])
}

model Delivery {
  id                 String                  @id @default(uuid())
  orderId            String                  @unique
  agentId            String?
  status             DeliveryStatus          @default(PENDING)
  assignedAt         DateTime?
  pickedUpAt         DateTime?
  deliveredAt        DateTime?
  proofType          String?
  proofData          Json?
  pickupLocation     Json?
  deliveryLocation   Json?
  currentLocation    Json?
  route              Json[]
  notes              String?
  failureReason      String?
  deliveryOtp        String?
  otpExpiresAt       DateTime?
  estimatedArrival   DateTime?
  lastLocationUpdate DateTime?
  mobileStoreId      String?
  agent              User?                   @relation("DeliveryAgent", fields: [agentId], references: [id])
  mobileStore        MobileStore?            @relation(fields: [mobileStoreId], references: [id])
  order              Order                   @relation(fields: [orderId], references: [id])
  attempts           DeliveryAttempt[]
  statusHistory      DeliveryStatusHistory[]
  trackingEvents     OrderTrackingEvent[]

  @@index([agentId, status])
  @@index([status, assignedAt])
  @@index([status, deliveredAt])
  @@index([orderId])
}

model Chat {
  id          String      @id @default(uuid())
  orderId     String?
  senderId    String
  receiverId  String
  message     String
  messageType MessageType @default(TEXT)
  mediaUrl    String?
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  readAt      DateTime?
  order       Order?      @relation(fields: [orderId], references: [id])
  receiver    User        @relation("ChatReceiver", fields: [receiverId], references: [id])
  sender      User        @relation("ChatSender", fields: [senderId], references: [id])

  @@index([orderId, createdAt])
  @@index([senderId, receiverId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  channel   String[]
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type, createdAt])
  @@index([userId, createdAt])
}

model QueueJob {
  id          String    @id @default(uuid())
  type        String
  data        Json
  status      String
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  processedAt DateTime?

  @@index([type, status])
  @@index([createdAt])
}

model FailedSyncEvent {
  id            String           @id @default(uuid())
  orderId       String
  eventType     SyncEventType
  payload       Json
  retryCount    Int              @default(0)
  lastAttemptAt DateTime?
  status        FailedSyncStatus @default(PENDING)
  createdAt     DateTime         @default(now())

  @@index([status, createdAt])
  @@index([orderId, status])
}

model AuditLog {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  service        AuditService
  env            String             @db.VarChar(32)
  eventName      String             @db.VarChar(128)
  eventCategory  AuditEventCategory
  severity       AuditSeverity
  requestId      String?            @db.VarChar(128)
  eventId        String             @db.VarChar(128)
  idempotencyKey String             @unique(map: "uq_auditlog_idempotency_key") @db.VarChar(191)
  parentEventId  String?            @db.VarChar(128)
  origin         AuditOrigin
  entityType     String             @db.VarChar(64)
  entityId       String             @db.VarChar(64)
  payload        Json?
  beforeJson     Json?
  afterJson      Json?
  diffJson       Json?

  @@index([createdAt], map: "idx_auditlog_created_at")
  @@index([service, createdAt], map: "idx_auditlog_service_created")
  @@index([eventName, createdAt], map: "idx_auditlog_event_created")
  @@index([entityType, entityId, createdAt], map: "idx_auditlog_entity_created")
  @@index([requestId], map: "idx_auditlog_request_id")
  @@index([eventId], map: "idx_auditlog_event_id")
}

model AuditOutbox {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  availableAt    DateTime           @default(now()) @db.Timestamptz(6)
  processedAt    DateTime?          @db.Timestamptz(6)
  claimedAt      DateTime?          @db.Timestamptz(6)
  leaseUntil     DateTime?          @db.Timestamptz(6)
  status         OutboxStatus       @default(PENDING)
  retryCount     Int                @default(0)
  maxRetries     Int                @default(12)
  lastError      String?
  eventId        String             @db.VarChar(128)
  idempotencyKey String             @unique(map: "uq_auditoutbox_idempotency_key") @db.VarChar(191)
  service        AuditService
  eventName      String             @db.VarChar(128)
  eventCategory  AuditEventCategory
  severity       AuditSeverity
  origin         AuditOrigin
  entityType     String             @db.VarChar(64)
  entityId       String             @db.VarChar(64)
  requestId      String?            @db.VarChar(128)
  parentEventId  String?            @db.VarChar(128)
  payload        Json?
  beforeJson     Json?
  afterJson      Json?
  diffJson       Json?

  @@index([status, availableAt], map: "idx_auditoutbox_status_available")
  @@index([service, status, availableAt], map: "idx_auditoutbox_service_status_available")
  @@index([createdAt], map: "idx_auditoutbox_created")
  @@index([eventId], map: "idx_auditoutbox_event_id")
  @@index([status, leaseUntil], map: "idx_auditoutbox_status_lease")
}

model Category {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String?
  description         String?
  image               String?
  icon                String?
  isActive            Boolean             @default(true)
  displayOrder        Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  colorCode           String?
  categorySubtitle    String?
  metaDescription     String?
  metaKeywords        String[]
  metaTitle           String?
  schemaMarkup        Json?
  slug                String?             @unique
  categoryType        CategoryType[]      @default([REGULAR])
  masterProducts      MasterProduct[]
  products            Product[]
  subCategories       SubCategory[]
  variantInventory    VariantInventory[]
  warehouseCategories WarehouseCategory[]

  @@index([isActive, displayOrder])
}

model SubCategory {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String                 @db.VarChar(255)
  categoryId             String                 @db.Uuid
  description            String?
  image                  String?
  isActive               Boolean                @default(true)
  displayOrder           Int                    @default(0)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @default(now()) @updatedAt
  colorCode              String?
  metaKeyword            String?
  metaTitle              String?
  slug                   String?
  subtitle               String?
  metaDescription        String?
  schemaMarkup           Json?
  subCategoryType        SubCategoryType[]      @default([REGULAR])
  masterProducts         MasterProduct[]
  products               Product[]
  category               Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  warehouseSubCategories WarehouseSubCategory[]

  @@unique([name, categoryId])
  @@index([categoryId, isActive])
}


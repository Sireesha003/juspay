model Bundle {
  id            String       @id @default(cuid())
  name          String
  description   String?
  price         Float
  originalPrice Float
  imageUrl      String?
  isActive      Boolean      @default(true)
  tenantId      String       @default("VK001")
  storeId       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  items         BundleItem[]
}


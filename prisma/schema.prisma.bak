  warehouse           Warehouse                         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, warehouseCategoryId, subCategoryId])
  @@index([subCategoryId])
  @@index([warehouseCategoryId, isEnabled])
  @@index([warehouseCategoryId])
  @@index([warehouseId, isEnabled])
  @@index([warehouseId])
}

model WarehouseTransfer {
  id            String    @id @default(uuid())

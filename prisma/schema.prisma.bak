  scheduledSlotRef                                ScheduledDeliverySlot?    @relation(fields: [scheduledSlotId], references: [id])
  vehicle                                         Vehicle?                  @relation(fields: [vehicleId], references: [id])
  warehouse                                       Warehouse?                @relation(fields: [warehouseId], references: [id])
  OrderCancellation                               OrderCancellation?
  items                                           OrderItem[]
  modifications                                   OrderModification[]
  orderOtps                                       OrderOtp[]
  orderRatings                                    OrderRating[]
  orderReturnHistory                              OrderReturnHistory[]
  statusHistory                                   OrderStatusHistory[]
  trackingEvents                                  OrderTrackingEvent[]
  PackingTray                                     PackingTray[]
  payment                                         Payment?
  PaymentTransaction                              PaymentTransaction[]
  refundTransactions                              RefundTransaction[]
  returns                                         Return[]
  ReturnRequest                                   ReturnRequest[]
  RiskAssessment                                  RiskAssessment?
  Settlement                                      Settlement[]
  SlaLog                                          SlaLog[]

  @@index([agentId, status])
  @@index([cartType])
  @@index([consumerId, createdAt])
  @@index([consumerId, status])
  @@index([couponCode])
  @@index([createdAt])
  @@index([deliverySlotId])
  @@index([orderNumber])
  @@index([warehouseId, deliveryDate, deliverySlot])
  @@index([customerId])
}

model OrderItem {
  id                 String          @id @default(uuid())
  orderId            String
  productId          String
  productVariantId   String?
  bundleId           String?
  quantity           Int
  unit               StandardUnits   @default(PIECE)
  unitPrice          Float
  totalPrice         Float
  discount           Float           @default(0)
  hsnCode            String?
  mrp                Float?
  productImage       String?
  productName        String?
  taxAmount          Float           @default(0)
  cgst               Float           @default(0)
  igst               Float           @default(0)
  sgst               Float           @default(0)
  cancellationReason String?
  cancelledAt        DateTime?
  cancelledBy        String?
  isCancelled        Boolean         @default(false)
  isPicked           Boolean         @default(false)
  isRejected         Boolean         @default(false)
  isVerified         Boolean         @default(false)
  pickedQty          Int             @default(0)
  rejectReason       String?
  rejectRemarks      String?
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [productId], references: [id])
  productVariant     ProductVariant? @relation(fields: [productVariantId], references: [id])
  returns            Return[]

  @@index([isCancelled])
  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
  @@index([unit])
}

model OrderModification {

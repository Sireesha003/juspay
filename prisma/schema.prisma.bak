}

model MobileStoreInventory {
  id             String      @id @default(uuid())
  mobileStoreId  String
  variantId      String
  availableStock Int         @default(0)
  reservedStock  Int         @default(0)
  damagedStock   Int         @default(0)
  soldToday      Int         @default(0)

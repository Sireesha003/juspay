  mobileStore    MobileStore @relation(fields: [mobileStoreId], references: [id], onDelete: Cascade)
}

model MobileStoreRoute {
  id            String      @id @default(uuid())
  mobileStoreId String
  name          String
  status        String
  stops         Json?
  startedAt     DateTime?
  completedAt   DateTime?
  mobileStore   MobileStore @relation(fields: [mobileStoreId], references: [id], onDelete: Cascade)
}

model MobileStoreRouteExecution {
  id             String      @id @default(uuid())
  mobileStoreId  String
  routeId        String?
  status         String      @default("PLANNED")
  assignedRoute  String?
  startedAt      DateTime?
  completedAt    DateTime?
  currentStop    String?
  completedStops Int         @default(0)
  pendingStops   Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  mobileStore    MobileStore @relation(fields: [mobileStoreId], references: [id], onDelete: Cascade)
}

model MobileStoreShift {
  id            String      @id @default(uuid())
  mobileStoreId String
  shiftName     String
  driverId      String?
  salesStaffId  String?
  startTime     DateTime?
  endTime       DateTime?
  status        String      @default("SCHEDULED")

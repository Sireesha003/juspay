model Chat {
  id          String      @id @default(uuid())
  orderId     String?
  senderId    String
  receiverId  String
  message     String
  messageType MessageType @default(TEXT)
  mediaUrl    String?
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  readAt      DateTime?
  order       Order?      @relation(fields: [orderId], references: [id])
  receiver    User        @relation("ChatReceiver", fields: [receiverId], references: [id])
  sender      User        @relation("ChatSender", fields: [senderId], references: [id])

  @@index([orderId, createdAt])
  @@index([senderId, receiverId])
}

model City {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityName   String    @db.VarChar(255)
  status     Status    @default(ACTIVE)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  cityIcon   String?   @db.VarChar(255)
  districtId String    @db.Uuid
  district   District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  zipCodes   ZipCode[]

  @@unique([districtId, cityName])
  @@index([districtId, status])
}

model ClosingCash {
  id            String     @id @default(cuid())
  vehicleId     String
  userId        String
  date          String
  openingCash   Float
  cashSales     Float
  expectedCash  Float
  actualCash    Float
  difference    Float
  denominations Json
  remark        String?
  status        String     @default("SUBMITTED")
  createdAt     DateTime   @default(now())
  tenantId      String     @default("VK001")
  shift         Int        @default(1)
  expenses      Float      @default(0)
  isNoService   Boolean    @default(false)
  storeId       String?
  cardSales     Float      @default(0)
  upiSales      Float      @default(0)
  store         Warehouse? @relation(fields: [storeId], references: [id])
  user          User       @relation(fields: [userId], references: [id])
  vehicle       Vehicle    @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, date, shift])
  @@index([tenantId])
  @@index([storeId])
}

model Cluster {
  id              String              @id @default(uuid())
  name            String
  code            String              @unique
  zoneId          String
  managerName     String?
  contactNumber   String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  location        Json?
  managerEmail    String?
  latitude        Float?
  longitude       Float?
  createdBy       String?
  updatedBy       String?
  isActive        Boolean             @default(true)
  coverageRadius  Float?
  serviceRegions  Json?
  coveredCities   Json?
  coveredPincodes Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  zone            Zone                @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  approvals       ClusterApproval[]
  auditLogs       ClusterAuditLog[]
  compliances     ClusterCompliance[]
  escalations     ClusterEscalation[]
  resources       ClusterResource[]
  settings        ClusterSetting?
  transfersTo     ClusterTransfer[]   @relation("TransfersTo")
  transfersFrom   ClusterTransfer[]   @relation("TransfersFrom")
  warehouses      Warehouse[]
}

model ClusterApproval {
  id           String   @id @default(uuid())
  clusterId    String
  requestType  String
  status       String   @default("PENDING")
  currentLevel String   @default("Zone Manager")
  requestedBy  String
  approvedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cluster      Cluster  @relation(fields: [clusterId], references: [id], onDelete: Cascade)
}

model ClusterAuditLog {
  id        String   @id @default(uuid())
  clusterId String
  action    String
  changedBy String
  createdAt DateTime @default(now())
  cluster   Cluster  @relation(fields: [clusterId], references: [id], onDelete: Cascade)
}

model ClusterCompliance {
  id           String    @id @default(uuid())
  clusterId    String
  documentName String
  documentUrl  String?
  status       String    @default("ACTIVE")
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())
  cluster      Cluster   @relation(fields: [clusterId], references: [id], onDelete: Cascade)
}

model ClusterEscalation {
  id            String   @id @default(uuid())
  clusterId     String
  issueType     String
  severityLevel String   @default("L1")
  status        String   @default("OPEN")
  description   String?
  reportedBy    String   @default("System")
  resolvedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  cluster       Cluster  @relation(fields: [clusterId], references: [id], onDelete: Cascade)
}

model ClusterResource {
  id           String   @id @default(uuid())
  clusterId    String
  role         String
  employeeId   String
  employeeName String
  assignedAt   DateTime @default(now())
  cluster      Cluster  @relation(fields: [clusterId], references: [id], onDelete: Cascade)
}

model ClusterSetting {
  id                String  @id @default(uuid())
  clusterId         String  @unique
  defaultRadius     Float?
  maxWarehouses     Int     @default(10)
  maxMobileStores   Int     @default(50)
  escalationLevels  Int     @default(3)
  notificationRules Json?
  cluster           Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
}

model Bundle {
  id          String       @id @default(uuid())
  name        String
  description String?
  bundlePrice Float        @default(0)
  mrp         Float        @default(0)
  image       String?
  status      String       @default("ACTIVE")
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  items       BundleItem[]
}

model BundleItem {
  id               String          @id @default(uuid())
  bundleId         String
  productId        String
  productVariantId String?
  quantity         Int             @default(1)
  bundle           Bundle          @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@index([bundleId])
  @@index([productId])
  @@index([productVariantId])
}

model ClusterTransfer {
  id                   String   @id @default(uuid())
  sourceClusterId      String
  destinationClusterId String
  transferType         String
  entityId             String
  status               String   @default("PENDING")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  destinationCluster   Cluster  @relation("TransfersTo", fields: [destinationClusterId], references: [id], onDelete: Cascade)
  sourceCluster        Cluster  @relation("TransfersFrom", fields: [sourceClusterId], references: [id], onDelete: Cascade)
}

model ContentManagement {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      ContentType
  title     String?     @db.VarChar(255)
  content   String?
  isDeleted Boolean     @default(false)
  createdAt DateTime    @default(now())
  status    Status      @default(ACTIVE)
  updatedAt DateTime    @default(now()) @updatedAt

  @@unique([type, isDeleted])
  @@index([type, isDeleted])
  @@map("ContentManagement")
}

model Country {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String     @unique @db.VarChar(255)
  displayOrder Int        @default(0)
  status       Status     @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  districts    District[]
  states       State[]
  zipCodes     ZipCode[]

  @@index([status, displayOrder])
>>>>>>> v11
}

model Coupon {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String             @db.VarChar(255)
  title              String?            @db.VarChar(255)
  description        String?
  type               String             @db.VarChar(50)
  value              Float
  maxDiscount        Float?
  minOrderValue      Float?
  startDate          DateTime
  expiryDate         DateTime
  isActive           Boolean            @default(true)
  scope              String?            @db.VarChar(50)
  warehouseId        String?
  applicablePincodes String[]           @default([])
  newUserOnly        Boolean            @default(false)
  firstOrderOnly     Boolean            @default(false)
  maxUsesPerUser     Int?
  maxTotalUses       Int?
  totalUses          Int                @default(0)
  termsUrl           String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt
  endTime            String?            @db.VarChar(20)
  startTime          String?            @db.VarChar(20)
  campaigns          Campaign[]
  cartApplications   Cart[]
  warehouse          Warehouse?         @relation(fields: [warehouseId], references: [id])
  redemptions        CouponRedemption[]
  orders             Order[]
  userAssignments    UserCoupon[]

  @@unique([code, warehouseId])
  @@index([code])
  @@index([isActive, startDate, expiryDate])
  @@index([warehouseId])
}

model CouponRedemption {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String
  couponId  String   @db.Uuid
  orderId   String
  discount  Float
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, couponId, orderId])
  @@index([userId, couponId])
  @@index([orderId])
}

model UserCoupon {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String
  couponId   String    @db.Uuid
  assignedAt DateTime  @default(now())
  usedAt     DateTime?
  expiresAt  DateTime?
  coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, couponId])
  @@index([userId, usedAt])
}

model Return {
  id              String       @id @default(uuid())
  orderId         String
  orderItemId     String?
  userId          String
  status          ReturnStatus @default(PENDING)
  reason          String?
  notes           String?
  refundAmount    Float
  refundMethod    String?
  refundedAt      DateTime?
  requestedAt     DateTime     @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem       OrderItem?   @relation(fields: [orderItemId], references: [id])
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([orderId])
  @@index([status, requestedAt])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @unique
  items     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserWishlists", fields: [userId], references: [id])
}

model OrderStatusHistory {
  id         String       @id @default(uuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  changedBy  String?
  reason     String?
  notes      String?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([toStatus, createdAt])
}

model DeliveryStatusHistory {
  id         String          @id @default(uuid())
  deliveryId String
  fromStatus DeliveryStatus?
  toStatus   DeliveryStatus
  changedBy  String?
  reason     String?
  metadata   Json?
  createdAt  DateTime        @default(now())
  delivery   Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
  @@index([toStatus, createdAt])
}

model PaymentStatusHistory {
  id         String         @id @default(uuid())
  paymentId  String
  fromStatus PaymentStatus?
  toStatus   PaymentStatus
  changedBy  String?
  reason     String?
  metadata   Json?
  createdAt  DateTime       @default(now())
  payment    Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([toStatus, createdAt])
}

model DeliveryAttempt {
  id          String   @id @default(uuid())
  deliveryId  String
  orderId     String
  attemptType String
  outcome     String?
  metadata    Json?
  agentId     String?
  createdAt   DateTime @default(now())
  agent       User?    @relation("DeliveryAttemptAgent", fields: [agentId], references: [id])
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt])
  @@index([orderId, createdAt])
  @@index([agentId])
}

model RefundTransaction {
  id              String                  @id @default(uuid())
  paymentId       String
  orderId         String
  idempotencyKey  String                  @unique
  amount          Float
  currency        String                  @default("INR")
  status          RefundTransactionStatus @default(PENDING)
  gatewayRefundId String?
  rawResponse     Json?
  requestedBy     String?
  expectedVersion Int?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  finalizedAt     DateTime?
  order           Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment         Payment                 @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([orderId])
  @@index([status, createdAt])
}

model OrderTrackingEvent {
  id          String    @id @default(uuid())
  orderId     String
  deliveryId  String?
  eventType   String
  fingerprint String?
  latitude    Float?
  longitude   Float?
  accuracy    Float?
  payload     Json?
  agentId     String?
  createdAt   DateTime  @default(now())
  agent       User?     @relation("OrderTrackingEventAgent", fields: [agentId], references: [id])
  delivery    Delivery? @relation(fields: [deliveryId], references: [id])
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([deliveryId, createdAt])
  @@index([agentId])
  @@index([fingerprint])
}

/// Append-only GPS samples for an order (analytics, dispute resolution, map replay).
model DeliveryLocationHistory {
  id        String   @id @default(uuid())
  orderId   String
  agentId   String?
  latitude  Float
  longitude Float
  accuracy  Float?
  source    String?  @default("DELIVERY_API")
  createdAt DateTime @default(now())
  agent     User?    @relation("DeliveryLocationHistoryAgent", fields: [agentId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([agentId, createdAt])
}

/// FCM / multi-channel dispatch audit trail (idempotent sends).
model NotificationDispatchLog {
  id              String   @id @default(uuid())
  idempotencyKey  String?  @unique
  type            String
  recipientUserId String?
  orderId         String?
  payload         Json?
  status          String
  fcmMessageId    String?
  error           String?
  correlationId   String?
  sourceService   String?
  createdAt       DateTime @default(now())

  @@index([recipientUserId, createdAt])
  @@index([orderId, createdAt])
  @@index([type, status, createdAt])
}

/// Best-effort WebSocket session audit (connect / disconnect).
model SocketSession {
  id               String    @id @default(uuid())
  userId           String
  namespace        String
  socketId         String
  serverInstanceId String?
  connectedAt      DateTime  @default(now())
  disconnectedAt   DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, namespace])
  @@index([connectedAt])
}

/// BullMQ job outcome log for operational dashboards.
model NotificationQueueLog {
  id          String    @id @default(uuid())
  jobId       String
  jobName     String
  status      String
  payload     Json?
  error       String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([jobName, createdAt])
  @@index([status, createdAt])
}

model OrderReturnHistory {
  id        String   @id @default(uuid())
  orderId   String
  fromPhase String?
  toPhase   String
  reason    String?
  metadata  Json?
  actorId   String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  key            String
  routeKey       String
  bodyHash       String?
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  userId         String

  @@unique([key, routeKey, userId])
  @@index([createdAt])
}

model DeliveryChargeRule {
  id            String     @id @default(uuid())
  warehouseId   String?
  pincode       String?
  minOrderValue Float?
  maxOrderValue Float?
  charge        Float
  freeAbove     Float?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId, pincode])
  @@index([isActive, warehouseId])
}

model OrderModification {
  id        String   @id @default(uuid())
  orderId   String
  type      String
  oldData   Json
  newData   Json
  changedBy String
  reason    String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([type, createdAt])
}

model DeliverySlot {
  id          String    @id @default(uuid())
  warehouseId String
  date        DateTime
  slot        String
  capacity    Int       @default(10)
  booked      Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  routeMapId  String?
  routeMap    RouteMap? @relation(fields: [routeMapId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@unique([warehouseId, date, slot, routeMapId])
  @@index([warehouseId, date])
  @@index([warehouseId, date, isActive])
  @@index([warehouseId, date, slot])
  @@index([isActive, date])
  @@index([routeMapId])
}

/// Store pickup slots with capacity; replaces Warehouse.pickupTimeSlots JSON for capacity tracking.
model PickupSlot {
  id          String    @id @default(uuid())
  warehouseId String
  date        DateTime  @db.Date
  startTime   String
  endTime     String
  slot        String
  repeat      Boolean   @default(false)
  repeatType  String?
  customDays  String[]  @default([])
  capacity    Int       @default(10)
  booked      Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orders      Order[]
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, date, startTime, endTime])
  @@index([warehouseId, date])
  @@index([warehouseId, date, isActive])
  @@index([isActive, date])
}

/// Dates when warehouse does not deliver (holidays, blackout).
model WarehouseDeliveryBlackout {
  id          String    @id @default(uuid())
  warehouseId String
  date        DateTime  @db.Date
  reason      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, date])
  @@index([warehouseId, date])
}

model IntroScreen {
  id           String   @id @default(uuid())
  title        String
  subtitle     String?
  imageUrl     String?
  videoUrl     String?
  displayOrder Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model AppContentLink {
  id        String   @id @default(uuid())
  roleName  String
  title     String
  titleType String
  subTitle  String
  icon      String
  linkPath  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleName, isActive])
}

model Suggestion {
  id         String   @id @default(uuid())
  suggestion String
  roleName   String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DeliveryRelatedQuestion {
  id        String   @id @default(uuid())
  question  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model OrderRating {
  id                String   @id @default(uuid())
  userId            String
  deliveryBoyId     String?
  orderId           String
  orderRating       Int?
  orderReview       String?
  deliveryRating    Int?
  deliveryReview    String?
  deliveryQuestions Json?    @default("[]")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deliveryBoy       User?    @relation("DeliveryBoyRatings", fields: [deliveryBoyId], references: [id])
  order             Order    @relation(fields: [orderId], references: [id])
  user              User     @relation("UserOrderRatings", fields: [userId], references: [id])

  @@index([userId])
  @@index([deliveryBoyId])
  @@index([orderId])
}

model DeliveryAssignment {
  id                 String                   @id @default(uuid())
  orderId            String                   @unique
  warehouseId        String?
  orderNumber        String?
  orderDate          DateTime                 @default(now())
  agentId            String
  amount             Float
  baseCharge         Float?
  surgeCharge        Float?
  tip                Float?
  platformCommission Float?
  adjustments        Json?
  status             DeliveryAssignmentStatus @default(UNPAID)
  payoutId           String?
  assignedFrom       String?
  notes              String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  agent              User                     @relation(fields: [agentId], references: [id])
  order              Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse          Warehouse?               @relation(fields: [warehouseId], references: [id])

  @@index([agentId, status])
  @@index([warehouseId, orderDate])
  @@index([status, createdAt])
}

model AgentCashCollection {
  id        String   @id @default(uuid())
  agentId   String
  amount    Float
  orderId   String?
  notes     String?
  createdAt DateTime @default(now())
  agent     User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id])

  @@index([agentId])
}

model AgentWithdrawal {
  id          String    @id @default(uuid())
  agentId     String
  amount      Float
  status      String
  requestedAt DateTime  @default(now())
  processedAt DateTime?
  agent       User      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([status])
}

model Module {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique @db.VarChar(100)
  status      Status           @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
}

model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique @db.VarChar(100)
  description String?
  status      Status           @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
}

model RolePermission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId    String   @db.Uuid
  moduleId  String   @db.Uuid
  canView   Boolean  @default(false)
  canCreate Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  canManage Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    Status   @default(ACTIVE)
  Module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  Role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId])
  @@index([roleId, moduleId])
}

model Unit {
  id           String   @id @default(uuid())
  name         String   @unique
  shortCode    String   @unique
  conversion   Float?
  status       Status   @default(ACTIVE)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  unitTypeId   String
  unitType     UnitType @relation(fields: [unitTypeId], references: [id])

  @@index([status, displayOrder])
  @@index([unitTypeId])
}

model Tax {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String   @db.VarChar(255)
  percentage   Decimal  @db.Decimal(5, 2)
  status       Status   @default(ACTIVE)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([status, displayOrder])
}

model Attribute {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String        @unique @db.VarChar(255)
  type         AttributeType
  isRequired   Boolean       @default(false)
  isFilterable Boolean       @default(false)
  isSearchable Boolean       @default(false)
  status       Status        @default(ACTIVE)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  @@index([status, displayOrder])
}

model Country {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String     @unique @db.VarChar(255)
  displayOrder Int        @default(0)
  status       Status     @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  districts    District[]
  states       State[]
  zipCodes     ZipCode[]

  @@index([status, displayOrder])
}

model State {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stateName String     @db.VarChar(255)
  stateIcon String?    @db.VarChar(255)
  status    Status     @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  countryId String     @db.Uuid
  districts District[]
  country   Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  zipCodes  ZipCode[]

  @@unique([countryId, stateName])
  @@index([countryId, status])
}

model District {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  districtName String    @db.VarChar(255)
  status       Status    @default(ACTIVE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  stateId      String    @db.Uuid
  countryId    String?   @db.Uuid
  cities       City[]
  country      Country?  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  state        State     @relation(fields: [stateId], references: [id], onDelete: Cascade)
  zipCodes     ZipCode[]

  @@unique([stateId, districtName])
  @@index([stateId, status])
}

model City {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cityName   String    @db.VarChar(255)
  status     Status    @default(ACTIVE)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  cityIcon   String?   @db.VarChar(255)
  districtId String    @db.Uuid
  district   District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  zipCodes   ZipCode[]

  @@unique([districtId, cityName])
  @@index([districtId, status])
}

model ZipCode {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zipCode    String   @db.VarChar(6)
  status     Status   @default(ACTIVE)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  countryId  String   @db.Uuid
  stateId    String   @db.Uuid
  districtId String   @db.Uuid
  cityId     String   @db.Uuid
  city       City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  country    Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  district   District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  state      State    @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([zipCode, cityId])
  @@index([countryId, stateId, districtId, cityId, status])
}

/// Table renamed from ContentManagment (typo). Map retained for DB.
model ContentManagement {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      ContentType
  title     String?     @db.VarChar(255)
  content   String?
  isDeleted Boolean     @default(false)
  createdAt DateTime    @default(now())
  status    Status      @default(ACTIVE)
  updatedAt DateTime    @default(now()) @updatedAt

  @@unique([type, isDeleted])
  @@index([type, isDeleted])
  @@map("ContentManagement")
}

/// Represents a local physical store acting as a hub for mobile delivery vehicles.
model Store {
  id                      String                    @id @default(uuid())
  userId                  String                    @unique
  name                    String
  description             String?
  categoryIds             Int[]
  taxName                 String?
  taxNumber               String?
  panNumber               String
  commission              Float                     @default(0)
  logoUrl                 String
  nationalIdUrl           String
  addressProofUrl         String
  createdAt               DateTime                  @default(now())
  status                  Status                    @default(ACTIVE)
  updatedAt               DateTime                  @default(now()) @updatedAt
  warehouseId             String?
  inventoryLocations      InventoryLocation[]
  mobileStores            MobileStore[]
  allocatedOrders         Order[]                   @relation("OrderAllocatedStore")
  ProcurementGoodsReceipt ProcurementGoodsReceipt[]
  ProcurementStockLedger  ProcurementStockLedger[]
  PurchaseInvoice         PurchaseInvoice[]
  PurchaseOrder           PurchaseOrder[]
  PurchaseRequisition     PurchaseRequisition[]
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse               Warehouse?                @relation(fields: [warehouseId], references: [id])
  Vendor                  Vendor[]
  VendorItemMapping       VendorItemMapping[]
  VendorLedger            VendorLedger[]
  VendorPayment           VendorPayment[]
}

model StockTransfer {
  id             String              @id @default(uuid())
  transferCode   String              @unique
  status         TransferStatus      @default(REQUESTED)
  notes          String?
  requestedById  String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  fromLocationId String
  toLocationId   String
  fromLocation   InventoryLocation   @relation("FromLocationTransfers", fields: [fromLocationId], references: [id])
  requestedBy    User                @relation(fields: [requestedById], references: [id])
  toLocation     InventoryLocation   @relation("ToLocationTransfers", fields: [toLocationId], references: [id])
  items          StockTransferItem[]

  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([status])
}

model StockTransferItem {
  id         String        @id @default(uuid())
  transferId String
  productId  String
  quantity   Int
  product    Product       @relation(fields: [productId], references: [id])
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@unique([transferId, productId])
}

model GoodsReceipt {
  id          String             @id @default(uuid())
  grnCode     String             @unique
  supplierId  String
  linkedPO    String?
  status      GRNStatus          @default(DRAFT)
  receivedAt  DateTime?
  createdById String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  locationId  String
  createdBy   User               @relation(fields: [createdById], references: [id])
  location    InventoryLocation  @relation(fields: [locationId], references: [id])
  supplier    Supplier           @relation(fields: [supplierId], references: [id])
  items       GoodsReceiptItem[]

  @@index([supplierId])
  @@index([locationId])
  @@index([status])
}

model GoodsReceiptItem {
  id        String       @id @default(uuid())
  grnId     String
  productId String
  quantity  Int
  grn       GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id])

  @@unique([grnId, productId])
}

model CycleCount {
  id           String           @id @default(uuid())
  locationId   String
  scope        String
  assignedToId String
  status       CycleCountStatus @default(OPEN)
  createdAt    DateTime         @default(now())
  completedAt  DateTime?
  assignedTo   User             @relation(fields: [assignedToId], references: [id])
  location     Warehouse        @relation(fields: [locationId], references: [id])

  @@index([locationId, status])
  @@index([assignedToId])
}

model UserDocument {
  id        String   @id @default(uuid())
  userId    String
  fileUrl   String
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  type      String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VendorSetting {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  requireProductApproval Boolean  @default(false)
  selfPickupMode         Boolean  @default(false)
  status                 Status   @default(ACTIVE)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Media {
  id           String    @id @default(uuid())
  fileName     String
  userId       String?
  extension    String
  fileType     String
  size         Float
  url          String
  subDirectory String
  sellerName   String?
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fileName])
  @@index([fileType])
  @@index([sellerName])
  @@index([isDeleted])
}

model StockAdjust {
  id             String         @id @default(uuid())
  productId      String
  warehouseId    String
  adjustmentType AdjustmentType
  reason         String
  quantity       Int
  notes          String?
  previousStock  Int
  newStock       Int
  createdAt      DateTime       @default(now())
  createdById    String?
  createdByUser  User?          @relation(fields: [createdById], references: [id])
  product        Product        @relation(fields: [productId], references: [id])
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])

  @@index([createdById])
}

model HomeImageSlide {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String        @db.VarChar(255)
  image     String        @db.VarChar(500)
  type      HomeSlideType
  status    Status        @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt

  @@index([type, status])
}

model WarehouseCategory {
  id             String                            @id @default(uuid())
  warehouseId    String
  categoryId     String                            @db.Uuid
  isEnabled      Boolean                           @default(true)
  effectiveFrom  DateTime?
  effectiveUntil DateTime?
  displayOrder   Int                               @default(0)
  notes          String?
  createdAt      DateTime                          @default(now())
  updatedAt      DateTime                          @updatedAt
  approvalStatus WarehouseCatSubCatApprovalStatus? @default(PENDING)
  inventory      VariantInventory[]
  category       Category                          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  warehouse      Warehouse                         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  subCategories  WarehouseSubCategory[]

  @@unique([warehouseId, categoryId])
  @@index([warehouseId, isEnabled])
  @@index([categoryId, isEnabled])
  @@index([warehouseId, isEnabled, effectiveFrom, effectiveUntil])
  @@index([effectiveFrom, effectiveUntil])
}

model ProductVariant {
  id                     String                 @id @default(uuid())
  productId              String
  sku                    String?
  gtin                   String?
  barcodeImage           String?
  variantName            String
  unit                   String?
  unitType               String
  measurement            String?
  status                 VariantStatus          @default(ACTIVE)
  primaryImages          String[]
  secondaryImages        String[]
  metaTitle              String?
  metaKeywords           String?
  metaDescription        String?
  schemaMarkup           String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  mrp                    Float                  @default(0)
  sellingPrice           Float?
  landingPrice           Float                  @default(0)
  discountType           String?
  discountValue          Float?
  stockQuantity          Int                    @default(0)
  minOrderQty            Int?                   @default(1)
  maxOrderQty            Int?
  lowStockThreshold      Int?                   @default(5)
  isEnabled              Boolean                @default(true)
  masterProductVariantId String?
  cartItems              CartItem[]
  cycleCountItems        CycleCountItem[]
  fulfillmentOrderItems  FulfillmentOrderItem[]
  inventoryBatches       InventoryBatch[]
  damageEntries          InventoryDamageEntry[]
  inventoryLedgers       InventoryLedger[]
  inventoryMovements     InventoryMovement[]
  reservations           InventoryReservation[]
  orderItems             OrderItem[]
  ProductLocation        ProductLocation[]
  ProductPrice           ProductPrice[]
  ProductTierPrice       ProductTierPrice[]
  masterProductVariant   MasterProductVariant?  @relation(fields: [masterProductVariantId], references: [id])
  product                Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  refillRequestItems     RefillRequestItem[]
  returnItems            ReturnItem[]
  stockLedgers           StockLedger[]
  unifiedInventory       UnifiedInventory[]
  inventory              VariantInventory[]
  vehicleInventory       VehicleInventory[]

  @@unique([productId, sku])
  @@unique([productId, masterProductVariantId])
  @@index([productId, status])
  @@index([sku])
  @@index([productId])
  @@index([isEnabled])
  @@index([masterProductVariantId])
}

model VariantInventory {
  id                  String             @id @default(uuid())
  variantId           String
  warehouseId         String
  categoryId          String             @db.Uuid
  onHand              Int                @default(0)
  reserved            Int                @default(0)
  availableToPromise  Int                @default(0)
  updatedAt           DateTime           @updatedAt
  warehouseCategoryId String?
  incomingStock       Int                @default(0)
  safetyStock         Int                @default(0)
  category            Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variant             ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouseCategory   WarehouseCategory? @relation(fields: [warehouseCategoryId], references: [id])
  warehouse           Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId, categoryId])
  @@index([warehouseId, categoryId, availableToPromise])
  @@index([variantId, warehouseId, categoryId])
  @@index([warehouseId, categoryId])
}

model OfferImage {
  id        String         @id @default(uuid())
  name      String
  type      OfferImageType
  image     String
  status    Status         @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model PopupOffer {
  id        String   @id @default(uuid())
  isEnabled Boolean  @default(true)
  type      String
  popupUrl  String
  link      String
  imageUrl  String
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id          String       @id @default(uuid())
  title       String
  subtitle    String?
  imageUrl    String
  redirectUrl String?
  isActive    Boolean      @default(true)
  status      BannerStatus @default(ACTIVE)
  startAt     DateTime?
  endAt       DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  bannerType  String?
  position    Int          @default(1)
  warehouseId String?
  warehouse   Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]

  @@index([warehouseId])
  @@index([warehouseId, isActive])
  @@index([warehouseId, status])
  @@index([position])
  @@index([startAt, endAt])
}

model WarehouseBusiness {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId             String
  legalBusinessName       String
  displayName             String
  businessType            String
  natureOfBusiness        String
  legalEntity             String
  yearOfEstablishment     DateTime
  areaOfIncorporationCity String
  areaOfRegistrationCity  String
  totalAreaSqft           String?
  deliveryType            String?
  storeOpenTime           String?
  storeCloseTime          String?
  averageDailyOrders      String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  isOperating             String[]  @default([])
  warehouse               Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
}

model WarehouseLocation {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId         String
  doorNo              String
  colonyOrVillage     String
  landmark            String?
  roadOrStreet        String
  district            String
  mandalOrTaluk       String
  city                String
  state               String
  pincode             String
  /// *
  /// * OPTIONAL (center point)
  latitude            Decimal?                   @db.Decimal(10, 7)
  longitude           Decimal?                   @db.Decimal(10, 7)
  isBackroomAvailable Boolean                    @default(false)
  fullAddress         String?
  locationSearchText  String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  area                String?
  /// *
  /// * REPLACE LAT/LNG
  geoPolygon          Json?
  warehouse           Warehouse                  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  pincodeCoverage     WarehousePincodeCoverage[]

  @@index([pincode])
  @@index([city, state])
}

model WarehouseBusinessDocument {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId             String
  isGstRegistered         Boolean   @default(false)
  hasPanOfBusiness        Boolean   @default(false)
  hasCompanyRegistration  Boolean   @default(false)
  hasShopEstablishment    Boolean   @default(false)
  hasUdyamRegistration    Boolean   @default(false)
  hasFssaiLicense         Boolean   @default(false)
  hasRentalAgreement      Boolean   @default(false)
  declarationAccepted     Boolean   @default(false)
  termsAccepted           Boolean   @default(false)
  kycAuthorizationGiven   Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  fssaiNumber             String?   @db.VarChar(20)
  gstNumber               String?   @db.VarChar(20)
  panNumber               String?   @db.VarChar(20)
  udyamRegistrationNumber String?   @db.VarChar(50)
  warehouse               Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
}

model WarehouseDocumentFile {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId  String
  fileUrl      String
  documentType String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
}

model MasterProduct {
  id                       String                 @id @default(uuid()) @db.Uuid
  name                     String
  slug                     String?                @unique
  description              String?
  shortDescription         String?
  images                   String[]
  tags                     String[]
  brandId                  String?                @db.Uuid
  categoryId               String                 @db.Uuid
  subCategoryId            String?                @db.Uuid
  productType              String?
  inventoryType            String?
  price                    Float
  mrp                      Float?
  discountType             String?
  discountValue            Float?
  finalPrice               Float?
  costPrice                Float?
  taxRate                  Float?                 @default(0)
  unitType                 String?
  unit                     String
  measurement              String?
  stock                    Int                    @default(0)
  threshold                Int                    @default(5)
  minOrderQty              Int?
  maxOrderQty              Int?
  isActive                 Boolean                @default(true)
  isFeatured               Boolean                @default(false)
  status                   ProductStatus          @default(PENDING)
  variantName              String?
  sku                      String?
  barcode                  String?
  variantStatus            Boolean                @default(true)
  weight                   Float                  @default(0)
  metaTitle                String?
  metaKeywords             String?
  metaDescription          String?
  schemaMarkup             String?
  manufacturer             String?
  madeIn                   String?
  fssaiLicNo               String?
  isReturnable             Boolean                @default(false)
  isCancelable             Boolean                @default(false)
  isCodAllowed             Boolean                @default(false)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  cancellableOrderStatuses String[]               @default([])
  returnableDays           Int?
  brand                    Brand?                 @relation(fields: [brandId], references: [id])
  category                 Category               @relation(fields: [categoryId], references: [id])
  subCategory              SubCategory?           @relation(fields: [subCategoryId], references: [id])
  variants                 MasterProductVariant[]
  products                 Product[]
  supplier                 Supplier[]             @relation("MasterSupplierProducts")

  @@index([name])
  @@index([categoryId, isActive])
  @@index([brandId, isActive])
  @@index([sku])
  @@index([barcode])
  @@index([status, isActive])
}

model MasterProductVariant {
  id                String           @id @default(uuid())
  masterProductId   String           @db.Uuid
  sku               String?          @unique
  gtin              String?
  barcodeImage      String?
  variantName       String
  unit              String?
  unitType          String
  measurement       String?
  primaryImages     String[]
  secondaryImages   String[]
  metaTitle         String?
  metaKeywords      String?
  metaDescription   String?
  schemaMarkup      String?
  status            VariantStatus    @default(ACTIVE)
  isEnabled         Boolean          @default(true)
  mrp               Float            @default(0)
  sellingPrice      Float?
  landingPrice      Float            @default(0)
  discountType      String?
  discountValue     Float?
  stockQuantity     Int              @default(0)
  lowStockThreshold Int?             @default(5)
  minOrderQty       Int?             @default(1)
  maxOrderQty       Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  masterProduct     MasterProduct    @relation(fields: [masterProductId], references: [id], onDelete: Cascade)
  productVariants   ProductVariant[]

  @@index([masterProductId])
  @@index([sku])
  @@index([status])
}

model UnitType {
  id           String         @id @default(uuid())
  name         String         @unique
  description  String?
  status       unitTypeStatus @default(ACTIVE)
  displayOrder Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  units        Unit[]

  @@index([status, displayOrder])
}

model WarehouseSubCategory {
  id                  String                            @id @default(uuid())
  warehouseId         String
  warehouseCategoryId String
  subCategoryId       String                            @db.Uuid
  createdAt           DateTime                          @default(now())

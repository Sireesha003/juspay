model ReturnRequest {
  id          String              @id @default(uuid())
  returnNo    String              @unique
  orderId     String
  userId      String
  status      ReturnRequestStatus @default(PENDING)
  totalRefund Float               @default(0)
  reason      String?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       ReturnItem[]
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model ReturnItem {
  id               String          @id @default(uuid())
  returnRequestId  String
  productId        String
  productVariantId String?
  quantity         Int
  refundAmount     Float
  reason           String?
  condition        String?
  product          Product         @relation(fields: [productId], references: [id])
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  returnRequest    ReturnRequest   @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([returnRequestId])
  @@index([productId])
}

model RouteStop {
  id            String   @id @default(uuid())
  routeId       String
  villageId     String
  stopOrder     Int
  estimatedTime String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  route         Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  village       Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@unique([routeId, villageId])
  @@index([routeId])
  @@index([villageId])
}

model RouteSchedule {
  id             String   @id @default(uuid())
  routeId        String
  scheduledDate  DateTime @db.Date
  startTime      String?
  endTime        String?
  assignedUserId String?
  status         String   @default("SCHEDULED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignedUser   User?    @relation(fields: [assignedUserId], references: [id])
  route          Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, scheduledDate])
  @@index([routeId])
}

model RouteExecution {
  id             String    @id @default(uuid())
  routeId        String
  driverId       String
  vehicleId      String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  startOdometer  Float
  endOdometer    Float?
  status         String    @default("IN_PROGRESS")
  cashCollected  Float     @default(0)
  upiCollected   Float     @default(0)
  expensesAmount Float     @default(0)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  driver         User      @relation(fields: [driverId], references: [id])
  route          Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id])

  @@index([routeId])
  @@index([driverId])
  @@index([vehicleId])
}

model VillageDemandForecast {
  id            String   @id @default(uuid())
  villageId     String
  productId     String
  forecastDate  DateTime @db.Date
  forecastedQty Float
  confidence    Float    @default(1.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  village       Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)

  @@unique([villageId, productId, forecastDate])
  @@index([villageId])
  @@index([productId])
}

model Settlement {
  id                 String            @id @default(uuid())
  orderId            String
  fulfillmentOrderId String?
  party              SettlementParty
  partyId            String
  amount             Float
  status             SettlementStatus  @default(PENDING)
  processedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  fulfillmentOrder   FulfillmentOrder? @relation(fields: [fulfillmentOrderId], references: [id])
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([fulfillmentOrderId])
  @@index([partyId])
}

model FulfillmentSLA {
  id                 String           @id @default(uuid())
  fulfillmentOrderId String           @unique
  allocatedAt        DateTime         @default(now())
  packedAt           DateTime?
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  slaLimitMinutes    Int
  isBreached         Boolean          @default(false)
  warningSent        Boolean          @default(false)
  createdAt          DateTime         @default(now())
  fulfillmentOrder   FulfillmentOrder @relation(fields: [fulfillmentOrderId], references: [id], onDelete: Cascade)
}

model CommissionRule {
  id                String  @id @default(uuid())
  partyType         String
  partyId           String?
  commissionPercent Float
  fixedFee          Float   @default(0)
  isActive          Boolean @default(true)
}

model OmsAuditLog {
  id         String   @id @default(uuid())
  orderId    String
  entityType String
  oldValue   Json?
  newValue   Json?
  changedBy  String?
  createdAt  DateTime @default(now())
}

model BusinessRule {
  id        String   @id @default(uuid())
  name      String
  ruleKey   String   @unique
  ruleValue String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DashboardMetrics {
  id          String   @id @default(uuid())
  metricKey   String   @unique
  metricValue Float
  updatedAt   DateTime @updatedAt
}

model PriceBook {
  id        String         @id @default(uuid())
  name      String
  code      String         @unique
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  prices    ProductPrice[]

  @@index([code])
}

model ProductPrice {
  id               String          @id @default(uuid())
  productId        String
  priceBookId      String
  mrp              Float
  sellingPrice     Float
  effectiveFrom    DateTime        @default(now())
  effectiveTo      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  productVariantId String?
  priceBook        PriceBook       @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  ProductVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productId, priceBookId])
  @@index([productVariantId, priceBookId])
}

model Shopkeeper {
  id               String   @id @default(uuid())
  name             String
  employeeId       String?
  phone            String?
  status           String   @default("Available")
  activeOrderCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  orders           Order[]  @relation("ShopkeeperOrders")
}

model PackingTray {
  id             String     @id @default(uuid())
  trayNumber     String     @unique
  warehouseId    String?
  isActive       Boolean    @default(false)
  currentOrderId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  currentOrder   Order?     @relation("TrayOrder", fields: [currentOrderId], references: [id])
  warehouse      Warehouse? @relation(fields: [warehouseId], references: [id])
}

model SlaLog {
  id           String    @id @default(uuid())
  orderId      String
  event        String
  expectedTime DateTime?
  actualTime   DateTime?
  breach       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  order        Order     @relation(fields: [orderId], references: [id])
}

model Rack {
  id          String    @id @default(uuid())
  name        String
  warehouseId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  shelves     Shelf[]

  @@unique([warehouseId, name])
}

model Shelf {
  id        String   @id @default(uuid())
  name      String
  rackId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rack      Rack     @relation(fields: [rackId], references: [id], onDelete: Cascade)
  trays     Tray[]

  @@unique([rackId, name])
}

model Tray {
  id               String            @id @default(uuid())
  name             String
  shelfId          String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  productLocations ProductLocation[]
  shelf            Shelf             @relation(fields: [shelfId], references: [id], onDelete: Cascade)

  @@unique([shelfId, name])
}

model ProductLocation {
  id               String          @id @default(uuid())
  productId        String
  productVariantId String?
  trayId           String
  warehouseId      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  tray             Tray            @relation(fields: [trayId], references: [id], onDelete: Cascade)
  warehouse        Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId, productVariantId])
}

model ConsumerSubscription {
  id           String   @id
  userId       String
  productId    String
  quantity     Int      @default(1)
  frequency    String
  status       String   @default("ACTIVE")
  nextDelivery DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Product      Product  @relation(fields: [productId], references: [id])
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LocationWaitlist {
  id           String    @id
  mobileNumber String
  pincode      String
  status       String    @default("PENDING")
  notifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime

  @@unique([mobileNumber, pincode])
  @@index([pincode])
  @@index([status])
}

model ProductTierPrice {
  id               String          @id
  productId        String
  productVariantId String?
  minQuantity      Int
  maxQuantity      Int?
  price            Float
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime
  Product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  ProductVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productVariantId])
}

model SavedPaymentMethod {
  id             String      @id
  userId         String
  methodType     PaymentMode
  provider       String?
  maskedNumber   String?
  expiryMonth    String?
  expiryYear     String?
  cardholderName String?
  upiId          String?
  gatewayToken   String?
  isDefault      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime
  User           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
}

model Translation {
  id           String   @id
  entityType   String
  entityId     String
  language     String
  translations Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@unique([entityType, entityId, language])
  @@index([entityType, entityId, language])
}

enum OnboardingStatus {
  IN_PROGRESS
  COMPLETED
}

enum ApprovalStatus {
  PENDING
  SUBMITTED
  PENDING_APPROVAL
  DOCUMENT_VERIFICATION
  FIELD_VISIT
  APPROVED
  REJECTED
}

enum ScheduledSlotRepeatType {
  ONCE
  DAILY
  WEEKLY
  MON_FRI
  SUN
  CUSTOM
}

enum OrderOtpType {
  PICKUP
  DELIVERY
}

enum CategoryType {
  REGULAR
  SPECIAL
}

enum SubCategoryType {
  REGULAR
  SPECIAL
}

enum HomeSlideType {
  DEFAULT
  BANNER
  PROMOTIONAL
}

enum AdjustmentType {
  INCREASE
  DECREASE
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  CONSUMER
  WAREHOUSE_STAFF
  DELIVERY_AGENT
  SUPER_ADMIN
  REGIONAL_ADMIN
  OPERATIONAL_ADMIN
  SUPPLIER
  VENDOR
  PARTNER
  OWNER
  DIRECTOR
  MANAGER
  VEHICLE_AGENT
  SHOPKEEPER
}

enum VehicleType {
  BIKE
  SCOOTER
  CAR
  TRUCK
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED

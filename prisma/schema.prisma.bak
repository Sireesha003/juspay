model UnifiedInventory {
  id               String            @id @default(uuid())
  productId        String
  productVariantId String?
  locationId       String
  onHand           Int               @default(0)
  reserved         Int               @default(0)
  available        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  location         InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant?   @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([productId, productVariantId, locationId])
  @@index([locationId])
  @@index([productId])
  @@index([productVariantId])
}

model InventoryBatch {
  id                String              @id @default(uuid())
  batchNumber       String
  lotNumber         String?
  productId         String
  productVariantId  String?
  locationId        String
  quantity          Int                 @default(0)
  manufacturingDate DateTime?
  expiryDate        DateTime?
  status            InvBatchStatus      @default(ACTIVE)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  location          InventoryLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant    ProductVariant?     @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  movements         InventoryMovement[]

  @@unique([productId, productVariantId, locationId, batchNumber])
  @@index([locationId])
  @@index([productId])
  @@index([productVariantId])
}

model InventoryMovement {
  id               String             @id @default(uuid())
  type             InvMovementType
  productId        String
  productVariantId String?
  fromLocationId   String?
  toLocationId     String?
  quantity         Int
  batchId          String?
  userId           String?
  referenceType    String?
  referenceId      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  batch            InventoryBatch?    @relation(fields: [batchId], references: [id])
  fromLocation     InventoryLocation? @relation("MovementFromLocation", fields: [fromLocationId], references: [id], onDelete: Cascade)
  product          Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant?    @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  toLocation       InventoryLocation? @relation("MovementToLocation", fields: [toLocationId], references: [id], onDelete: Cascade)
  user             User?              @relation("UserMovements", fields: [userId], references: [id])
  stockLedgers     StockLedger[]

  @@index([productId])
  @@index([productVariantId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([batchId])
  @@index([userId])
}

model StockLedger {
  id               String            @id @default(uuid())
  productId        String
  productVariantId String?
  locationId       String
  beforeQuantity   Int
  afterQuantity    Int
  changeQuantity   Int
  movementId       String
  referenceType    String?
  referenceId      String?
  createdAt        DateTime          @default(now())
  location         InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  movement         InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant?   @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productVariantId])
  @@index([locationId])
  @@index([movementId])
}

model InventoryReservation {
  id                 String               @id @default(uuid())
  productId          String
  productVariantId   String?
  locationId         String
  quantity           Int
  status             InvReservationStatus @default(PENDING)
  userId             String?
  orderId            String?
  expiresAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  fulfillmentOrderId String?
  fulfillmentOrder   FulfillmentOrder?    @relation(fields: [fulfillmentOrderId], references: [id])
  location           InventoryLocation    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  order              Order?               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant     ProductVariant?      @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  user               User?                @relation("UserReservations", fields: [userId], references: [id])

  @@index([productId])
  @@index([productVariantId])
  @@index([locationId])
  @@index([userId])
  @@index([orderId])
  @@index([fulfillmentOrderId])
}

model VehicleInventory {
  id               String          @id @default(uuid())
  vehicleId        String
  productId        String
  productVariantId String?
  quantity         Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  vehicle          VehicleInfo     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, productId, productVariantId])
  @@index([vehicleId])
  @@index([productId])
  @@index([productVariantId])
}

model InventoryDamageEntry {
  id               String            @id @default(uuid())
  productId        String
  productVariantId String?
  locationId       String
  quantity         Int
  reportedById     String?
  status           InvDamageStatus   @default(REPORTED)
  reason           String?
  estimatedLoss    Decimal?          @db.Decimal(10, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  damageType       DamageType?
  images           String[]
  location         InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant?   @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  reportedBy       User?             @relation("UserDamageEntries", fields: [reportedById], references: [id])

  @@index([productId])
  @@index([productVariantId])
  @@index([locationId])
  @@index([reportedById])
}

model InventoryCycleCount {
  id           String              @id @default(uuid())
  locationId   String
  status       InvCycleCountStatus @default(OPEN)
  assignedToId String?
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        CycleCountItem[]
  approvedBy   User?               @relation("UserApprovedCycleCounts", fields: [approvedById], references: [id])
  assignedTo   User?               @relation("UserCycleCounts", fields: [assignedToId], references: [id])
  location     InventoryLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([assignedToId])
  @@index([approvedById])
}

model CycleCountItem {
  id               String              @id @default(uuid())
  cycleCountId     String
  productId        String
  productVariantId String?
  systemQuantity   Int
  countedQuantity  Int
  variance         Int
  remarks          String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  cycleCount       InventoryCycleCount @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant?     @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([cycleCountId])
  @@index([productId])
  @@index([productVariantId])
}

model InventoryRefillRequest {
  id             String              @id @default(uuid())
  fromLocationId String
  toLocationId   String
  status         InvRefillStatus     @default(PENDING)
  requestedById  String?
  approvedById   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  approvedBy     User?               @relation("RefillApprover", fields: [approvedById], references: [id])
  fromLocation   InventoryLocation   @relation("RefillFromLocation", fields: [fromLocationId], references: [id], onDelete: Cascade)
  requestedBy    User?               @relation("RefillRequester", fields: [requestedById], references: [id])
  toLocation     InventoryLocation   @relation("RefillToLocation", fields: [toLocationId], references: [id], onDelete: Cascade)
  items          RefillRequestItem[]

  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([requestedById])
  @@index([approvedById])
}

model RefillRequestItem {
  id                String                 @id @default(uuid())
  refillRequestId   String
  productId         String
  productVariantId  String?
  quantityRequested Int
  quantityApproved  Int                    @default(0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  product           Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant    ProductVariant?        @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  refillRequest     InventoryRefillRequest @relation(fields: [refillRequestId], references: [id], onDelete: Cascade)

  @@index([refillRequestId])
  @@index([productId])
  @@index([productVariantId])
}

model Vehicle {
  id                String                  @id @default(cuid())
  vehicleNumber     String                  @unique
  status            Boolean                 @default(true)
  insuranceDocument String?
  permitDocument    String?
  rcDocument        String?
  vehicleName       String?
  storeId           String?
  displayId         String?                 @unique
  assetAssignments  AssetAssignment[]
  assetUnits        AssetUnit[]
  cashTransfers     CashTransfer[]
  closingCash       ClosingCash[]
  dailySummaries    DailyCashSummary[]
  dailyCoverages    DailyCoverage[]
  damageEntries     DamageEntry[]
  expenses          Expense[]
  fuelLogs          FuelLog[]
  maintenanceLogs   MaintenanceLog[]
  openingCash       OpeningCash[]
  orders            Order[]
  refillRequests    RefillRequest[]
  routeAssignments  RouteAssignment[]
  routeExecutions   RouteExecution[]
  stockAudits       StockAudit[]
  transactions      StockTransaction[]
  assignedUsers     User[]                  @relation("UserVehicle")
  store             Warehouse?              @relation(fields: [storeId], references: [id])
  physicalDamages   VehiclePhysicalDamage[]
  stocks            VehicleStock[]
  trips             VehicleTrip[]
}

model VehiclePhysicalDamage {
  id              String                @id @default(cuid())
  tenantId        String                @default("VK001")
  storeId         String?
  vehicleId       String
  reportedById    String
  damageType      String
  severity        VehicleDamageSeverity @default(MINOR)
  title           String
  description     String?
  location        String?
  images          String[]
  estimatedCost   Float?                @default(0)
  actualCost      Float?
  status          VehicleDamageStatus   @default(REPORTED)
  repairDate      DateTime?
  repairNotes     String?
  odometerReading Float?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  reportedBy      User                  @relation("VehicleDamageReporter", fields: [reportedById], references: [id])
  vehicle         Vehicle               @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([vehicleId])
  @@index([status])
}

model VehicleStock {
  id              String     @id @default(cuid())
  vehicleId       String
  productId       String
  quantity        Int        @default(0)
  openingQuantity Int        @default(0)
  tenantId        String     @default("VK001")
  storeId         String?
  product         Product    @relation(fields: [productId], references: [id])
  store           Warehouse? @relation(fields: [storeId], references: [id])
  vehicle         Vehicle    @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, productId])
  @@index([tenantId])
  @@index([storeId])
}

model VehicleTrip {
  id              String           @id @default(cuid())
  vehicleId       String
  userId          String
  date            String
  shift           Int              @default(1)
  status          TripStatus       @default(OPEN)
  startOdometer   Float?
  endOdometer     Float?
  openingCash     Float?           @default(0)
  closingCash     Float?           @default(0)
  totalSales      Float?           @default(0)
  totalExpenses   Float?           @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenantId        String           @default("VK001")
  storeId         String?
  fuelLogs        FuelLog[]
  maintenanceLogs MaintenanceLog[]
  user            User             @relation(fields: [userId], references: [id])
  vehicle         Vehicle          @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, date, shift])
  @@index([tenantId])
  @@index([storeId])
}

model FuelLog {
  id          String             @id @default(cuid())
  vehicleId   String
  tripId      String?
  date        String
  odometer    Float
  liters      Float
  rate        Float
  totalAmount Float
  paymentMode ExpensePaymentMode
  billImage   String?
  createdAt   DateTime           @default(now())
  tenantId    String             @default("VK001")
  storeId     String?
  trip        VehicleTrip?       @relation(fields: [tripId], references: [id])
  vehicle     Vehicle            @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([tripId])
}

model MaintenanceLog {
  id           String       @id @default(cuid())
  vehicleId    String
  tripId       String?
  date         String
  odometer     Float
  serviceType  String
  details      String?
  amount       Float
  mechanicName String?
  billImage    String?
  createdAt    DateTime     @default(now())
  tenantId     String       @default("VK001")
  storeId      String?
  trip         VehicleTrip? @relation(fields: [tripId], references: [id])
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([tripId])
}

model StockTransaction {
  id        String          @id @default(cuid())
  date      DateTime        @default(now())
  type      TransactionType
  vehicleId String
  productId String
  quantity  Int
  tenantId  String          @default("VK001")
  storeId   String?
  userId    String?
  product   Product         @relation(fields: [productId], references: [id])
  store     Warehouse?      @relation(fields: [storeId], references: [id])
  user      User?           @relation("UserStockTransactions", fields: [userId], references: [id])
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([date])
  @@index([type])
  @@index([vehicleId])
  @@index([productId])
  @@index([userId])
}

model Route {
  id               String              @id @default(cuid())
  routeName        String
  villages         String[]
  status           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tenantId         String              @default("VK001")
  storeId          String?
  orders           Order[]
  store            Warehouse?          @relation(fields: [storeId], references: [id])
  assignments      RouteAssignment[]
  cycles           RouteCycle[]
  routeExecutions  RouteExecution[]
  routeSchedules   RouteSchedule[]
  stops            RouteStop[]
  monthlySummaries VgeMonthlySummary[]

  @@unique([tenantId, storeId, routeName])
  @@index([tenantId])
  @@index([status])
  @@index([storeId])
}

model RouteCycle {
  id          String    @id @default(cuid())
  routeId     String
  dayOfWeek   DayOfWeek
  villageName String
  tenantId    String    @default("VK001")
  route       Route     @relation(fields: [routeId], references: [id])

  @@unique([routeId, dayOfWeek])
  @@index([tenantId])
}

model RouteAssignment {
  id               String       @id @default(cuid())
  vehicleId        String
  userId           String
  routeId          String
  startDate        DateTime     @default(now())
  status           Boolean      @default(true)
  afternoonSession String?
  morningSession   String?
  schedule         Json?
  tenantId         String       @default("VK001")
  shiftConfigId    String?
  shiftConfig      ShiftConfig? @relation(fields: [shiftConfigId], references: [id])
  route            Route        @relation(fields: [routeId], references: [id])
  user             User         @relation(fields: [userId], references: [id])
  vehicle          Vehicle      @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([vehicleId, status])
  @@index([userId, status])
}

model ShiftConfig {
  id               String            @id @default(cuid())
  tenantId         String            @default("VK001")
  shiftType        String
  shiftName        String
  isActive         Boolean           @default(true)
  startTime        String?
  endTime          String?
  sessions         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  routeAssignments RouteAssignment[]

  @@index([tenantId])
}

model Village {
  id              String                  @id @default(cuid())
  name            String
  status          Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  tenantId        String                  @default("VK001")
  latitude        Float?
  longitude       Float?
  storeId         String?
  radius          Int                     @default(500)
  boundary        Json?
  isPolygon       Boolean                 @default(false)
  customers       Customer[]
  routeStops      RouteStop[]
  store           Warehouse?              @relation(fields: [storeId], references: [id])
  activities      VillageActivity[]
  demandForecasts VillageDemandForecast[]

  @@unique([tenantId, storeId, name])
  @@index([tenantId])
  @@index([storeId])
}

model OpeningCash {
  id               String     @id @default(cuid())
  vehicleId        String
  userId           String
  date             String
  denominations    Json
  totalOpeningCash Float
  status           String     @default("SUBMITTED")
  createdAt        DateTime   @default(now())
  tenantId         String     @default("VK001")
  shift            Int        @default(1)
  isNoService      Boolean    @default(false)
  storeId          String?
  store            Warehouse? @relation(fields: [storeId], references: [id])
  user             User       @relation(fields: [userId], references: [id])
  vehicle          Vehicle    @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, date, shift])
  @@index([tenantId])
  @@index([storeId])
}

model ClosingCash {
  id            String     @id @default(cuid())
  vehicleId     String
  userId        String
  date          String
  openingCash   Float
  cashSales     Float
  expectedCash  Float
  actualCash    Float
  difference    Float
  denominations Json
  remark        String?
  status        String     @default("SUBMITTED")
  createdAt     DateTime   @default(now())
  tenantId      String     @default("VK001")
  shift         Int        @default(1)
  expenses      Float      @default(0)
  isNoService   Boolean    @default(false)
  storeId       String?
  cardSales     Float      @default(0)
  upiSales      Float      @default(0)
  store         Warehouse? @relation(fields: [storeId], references: [id])
  user          User       @relation(fields: [userId], references: [id])
  vehicle       Vehicle    @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, date, shift])
  @@index([tenantId])
  @@index([storeId])
}

model BusinessSettings {
  id                     String     @id @default(cuid())
  businessName           String     @default("VillagKart")
  gstNo                  String?
  contactNo              String?
  email                  String?
  address                String?
  taxRates               String     @default("0,5,12,18")
  updatedAt              DateTime   @updatedAt
  tenantId               String     @default("VK001")
  storeId                String?    @unique
  shifts                 Json?
  shiftMode              String     @default("STANDARD")
  deliveryRadius         Float?     @default(20)
  deliveryRadiusEnforced Boolean    @default(true)
  deliverySlabs          Json?
  deliverySlots          Json?
  surcharges             Json?
  store                  Warehouse? @relation(fields: [storeId], references: [id])

  @@unique([tenantId, storeId])
  @@index([tenantId])
  @@index([storeId])
}

model DailyCashSummary {
  id            String     @id @default(cuid())
  vehicleId     String
  date          String
  openingCash   Float      @default(0)
  cashSales     Float      @default(0)
  expectedCash  Float      @default(0)
  actualCash    Float      @default(0)
  difference    Float      @default(0)
  status        String     @default("PENDING")
  updatedAt     DateTime   @updatedAt
  expenses      Float      @default(0)
  submittedCash Float      @default(0)
  userId        String?
  tenantId      String     @default("VK001")
  storeId       String?
  cardSales     Float      @default(0)
  upiSales      Float      @default(0)
  store         Warehouse? @relation(fields: [storeId], references: [id])
  user          User?      @relation("UserDailyCashSummary", fields: [userId], references: [id])
  vehicle       Vehicle    @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, date])
  @@index([tenantId])
  @@index([date])
  @@index([userId])
  @@index([storeId])
}

model StoreCashRegister {
  id                   String    @id @default(cuid())
  tenantId             String    @default("VK001")
  storeId              String
  date                 String
  openingCash          Float
  openingDenominations Json
  expectedClosingCash  Float?
  actualClosingCash    Float?
  closingDifference    Float?
  closingDenominations Json?
  status               String    @default("OPEN")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  closedById           String?
  openedById           String?
  closingRemarks       String?
  closedBy             User?     @relation("ClosedRegisters", fields: [closedById], references: [id])
  openedBy             User?     @relation("OpenedRegisters", fields: [openedById], references: [id])
  store                Warehouse @relation(fields: [storeId], references: [id])

  @@unique([storeId, date])
  @@index([tenantId])
  @@index([openedById])
  @@index([closedById])
}

model StoreDeposit {
  id            String    @id @default(cuid())
  tenantId      String    @default("VK001")
  storeId       String
  date          String
  shift         Int
  amount        Float
  denominations Json
  description   String
  userId        String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  store         Warehouse @relation(fields: [storeId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@unique([storeId, date, shift])
  @@index([tenantId])
}

model Expense {
  id          String             @id @default(cuid())
  userId      String
  vehicleId   String?
  type        String
  amount      Float
  paymentMode ExpensePaymentMode
  description String?
  billImage   String?
  status      ExpenseStatus      @default(PENDING)
  date        String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenantId    String             @default("VK001")
  storeId     String?
  displayId   String?
  billDate    String?
  paidDate    String?
  paidTo      String?
  store       Warehouse?         @relation(fields: [storeId], references: [id])
  user        User               @relation(fields: [userId], references: [id])
  vehicle     Vehicle?           @relation(fields: [vehicleId], references: [id])

  @@unique([tenantId, displayId])
  @@index([tenantId])
  @@index([userId])
  @@index([vehicleId])
  @@index([date])
  @@index([status])
  @@index([storeId])
}

model CashTransfer {
  id            String     @id @default(cuid())
  userId        String
  vehicleId     String
  date          String
  amount        Float
  denominations Json?
  status        String     @default("SUBMITTED")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  tenantId      String     @default("VK001")
  storeId       String?
  store         Warehouse? @relation(fields: [storeId], references: [id])
  user          User       @relation(fields: [userId], references: [id])
  vehicle       Vehicle    @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, date])
  @@index([tenantId])
  @@index([userId])
  @@index([storeId])
}

model ExpenseCategory {
  id            String               @id @default(cuid())
  name          String
  limit         Float?
  status        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  tenantId      String               @default("VK001")
  subCategories ExpenseSubCategory[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ExpenseSubCategory {
  id                String          @id @default(cuid())
  tenantId          String          @default("VK001")
  expenseCategoryId String
  name              String
  status            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  category          ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)

  @@unique([tenantId, expenseCategoryId, name])
  @@index([tenantId])
  @@index([expenseCategoryId])
}

model DailyCoverage {
  id          String     @id @default(cuid())
  vehicleId   String
  routeId     String?
  date        String
  villageName String
  morningDone Boolean    @default(false)
  eveningDone Boolean    @default(false)
  status      String     @default("PENDING")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenantId    String     @default("VK001")
  storeId     String?
  shiftStatus Json?
  store       Warehouse? @relation(fields: [storeId], references: [id])
  vehicle     Vehicle    @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, date])
  @@index([tenantId])
  @@index([date])
  @@index([storeId])
}

model RefillRequest {
  id           String       @id @default(cuid())
  vehicleId    String
  userId       String
  status       RefillStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tenantId     String       @default("VK001")
  storeId      String?
  parentId     String?
  accuracy     Float?
  amount       Float?
  lat          Float?
  long         Float?
  photo        String?
  approvedById String?
  items        RefillItem[]
  approvedBy   User?        @relation("ApprovedRefills", fields: [approvedById], references: [id])
  store        Warehouse?   @relation(fields: [storeId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([vehicleId])
  @@index([userId])
  @@index([status])
  @@index([storeId])
  @@index([parentId])
}

model RefillItem {
  id                String        @id @default(cuid())
  refillRequestId   String
  productId         String
  quantity          Int
  tenantId          String        @default("VK001")
  adminRemark       String?
  requestedQuantity Int?
  storeId           String?
  product           Product       @relation(fields: [productId], references: [id])
  refillRequest     RefillRequest @relation(fields: [refillRequestId], references: [id], onDelete: Cascade)
  store             Warehouse?    @relation(fields: [storeId], references: [id])

  @@index([tenantId])
  @@index([refillRequestId])
  @@index([productId])
  @@index([storeId])
}

model VgeDailyPerformance {
  id                 String     @id @default(cuid())
  userId             String
  date               String
  totalSales         Float      @default(0)
  totalRegistrations Int        @default(0)
  completedOrders    Int        @default(0)
  eligibleSales      Float      @default(0)
  slabsCount         Int        @default(0)
  salesIncentive     Float      @default(0)
  regIncentive       Float      @default(0)
  totalIncentive     Float      @default(0)
  isLocked           Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  routeId            String?
  tenantId           String     @default("VK001")
  storeId            String?
  level              String     @default("NONE")
  store              Warehouse? @relation(fields: [storeId], references: [id])
  user               User       @relation("UserDailyPerformance", fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([tenantId])
  @@index([date])
  @@index([userId])
  @@index([level])
  @@index([storeId])
}

model VgeMonthlySummary {
  id                 String     @id @default(cuid())
  userId             String
  month              String
  totalSales         Float      @default(0)
  totalRegistrations Int        @default(0)
  totalIncentive     Float      @default(0)
  totalOrders        Int        @default(0)
  workingDays        Int        @default(0)
  avgLevel           String?
  bestLevel          VgeLevel   @default(NONE)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  isLocked           Boolean    @default(false)
  metadata           Json?
  routeId            String?
  tenantId           String     @default("VK001")
  storeId            String?
  route              Route?     @relation(fields: [routeId], references: [id])
  store              Warehouse? @relation(fields: [storeId], references: [id])
  user               User       @relation("UserMonthlySummary", fields: [userId], references: [id])

  @@unique([userId, month])
  @@index([tenantId])
  @@index([month])
  @@index([storeId])
}

model VgeIncentiveConfig {
  id                     String     @id @default(cuid())
  minSalesThreshold      Float      @default(10000)
  minRegThreshold        Int        @default(5)
  salesSlabSize          Float      @default(5000)
  firstSlabCount         Int        @default(2)
  firstSlabIncentive     Float      @default(50)
  remainingSlabIncentive Float      @default(100)
  firstRegCount          Int        @default(10)
  firstRegIncentive      Float      @default(10)
  remainingRegIncentive  Float      @default(15)
  starterThreshold       Float      @default(10000)
  performerThreshold     Float      @default(15000)
  achieverThreshold      Float      @default(20000)
  championThreshold      Float      @default(25000)
  starThreshold          Float      @default(30000)
  superStarThreshold     Float      @default(35000)
  updatedAt              DateTime   @updatedAt
  tenantId               String     @default("VK001")
  rules                  Json       @default("[]")
  baseSalary             Float      @default(15000)
  storeId                String?
  store                  Warehouse? @relation(fields: [storeId], references: [id])

  @@unique([tenantId, storeId])
  @@index([tenantId])
  @@index([storeId])
}

model Asset {
  id            String         @id @default(cuid())
  name          String
  model         String?
  brand         String?
  image         String?
  description   String?
  estimatedCost Float          @default(0)
  totalQuantity Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenantId      String         @default("VK001")
  categoryId    String?
  assetType     String?
  storeId       String?
  category      AssetCategory? @relation(fields: [categoryId], references: [id])
  store         Warehouse?     @relation(fields: [storeId], references: [id])
  requests      AssetRequest[]
  units         AssetUnit[]

  @@index([tenantId])
  @@index([categoryId])
  @@index([storeId])
}

model AssetCategory {
  id        String     @id @default(cuid())
  tenantId  String     @default("VK001")
  name      String
  status    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  storeId   String?
  assets    Asset[]
  store     Warehouse? @relation(fields: [storeId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([storeId])
}

model AssetUnit {
  id           String            @id @default(cuid())
  assetId      String
  serialNumber String?
  status       AssetStatus       @default(AVAILABLE)
  condition    AssetCondition    @default(NEW)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  tenantId     String            @default("VK001")
  vehicleId    String?
  assignments  AssetAssignment[]
  issues       AssetIssue[]
  requests     AssetRequest[]
  asset        Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?          @relation(fields: [vehicleId], references: [id])

  @@unique([assetId, serialNumber])
  @@index([tenantId])
  @@index([assetId])
  @@index([status])
  @@index([vehicleId])
}

model AssetAssignment {
  id              String          @id @default(cuid())
  assetUnitId     String
  userId          String
  assignedDate    DateTime        @default(now())
  returnDate      DateTime?
  assignCondition AssetCondition  @default(NEW)
  returnCondition AssetCondition?
  returnRemarks   String?
  quantity        Int             @default(1)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tenantId        String          @default("VK001")
  vehicleId       String?
  assetUnit       AssetUnit       @relation(fields: [assetUnitId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id])
  vehicle         Vehicle?        @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([assetUnitId])
  @@index([userId])
  @@index([isActive])
  @@index([vehicleId])
}

model AssetIssue {
  id          String           @id @default(cuid())
  assetUnitId String
  userId      String
  issueType   AssetIssueType
  description String?
  photos      String[]
  status      AssetIssueStatus @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenantId    String           @default("VK001")
  assetUnit   AssetUnit        @relation(fields: [assetUnitId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([assetUnitId])
  @@index([userId])
  @@index([status])
}

model AssetRequest {
  id          String           @id @default(cuid())
  tenantId    String           @default("VK001")
  userId      String
  type        AssetRequestType
  assetId     String?
  assetUnitId String?
  description String?
  priority    String           @default("MEDIUM")
  status      RequestStatus    @default(PENDING)
  adminRemark String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  asset       Asset?           @relation(fields: [assetId], references: [id])
  assetUnit   AssetUnit?       @relation(fields: [assetUnitId], references: [id])
  user        User             @relation("UserAssetRequests", fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([status])
}

model AssetDepreciation {
  id              String   @id @default(cuid())
  assetId         String
  tenantId        String   @default("VK001")
  costBasis       Float    @default(0)
  salvageValue    Float    @default(0)
  usefulLifeYears Int      @default(5)
  method          String   @default("STRAIGHT_LINE")
  ratePercentage  Float    @default(20)
  currentBookVal  Float    @default(0)
  lastCalculated  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([assetId])
}

model AssetAuditLog {
  id                String   @id @default(cuid())
  assetId           String?
  assetUnitId       String?
  tenantId          String   @default("VK001")
  auditedByUserId   String
  auditDate         DateTime @default(now())
  status            String   @default("VERIFIED")
  physicalCondition String   @default("GOOD")
  remarks           String?
  createdAt         DateTime @default(now())

  @@index([tenantId])
  @@index([assetId])
  @@index([assetUnitId])
  @@index([auditedByUserId])
}

model AssetTransferLog {
  id            String   @id @default(cuid())
  tenantId      String   @default("VK001")
  assetId       String?
  assetUnitId   String?
  quantity      Int      @default(1)
  fromType      String
  fromId        String
  fromLabel     String?
  toType        String
  toId          String
  toLabel       String?
  reason        String?
  notes         String?
  status        String   @default("COMPLETED")
  initiatedById String?
  unitIds       String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([assetId])
  @@index([initiatedById])
  @@index([createdAt])
}

model LocationCheckIn {
  id                String     @id @default(cuid())
  tenantId          String     @default("VK001")
  userId            String
  date              String
  time              DateTime   @default(now())
  latitude          Float
  longitude         Float
  villageName       String?
  status            String
  createdAt         DateTime   @default(now())
  isLocationMatched Boolean    @default(true)
  storeId           String?
  subLocation       String?
  store             Warehouse? @relation(fields: [storeId], references: [id])
  user              User       @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([date])
  @@index([storeId])
}

model SafeTransaction {
  id            String    @id @default(cuid())
  tenantId      String    @default("VK001")
  storeId       String
  date          String
  amount        Float
  type          String
  denominations Json?
  description   String?
  userId        String
  createdAt     DateTime  @default(now())
  store         Warehouse @relation(fields: [storeId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@index([storeId, date])
}

model StockAudit {
  id        String           @id @default(cuid())
  tenantId  String           @default("VK001")
  storeId   String?
  vehicleId String
  userId    String
  createdAt DateTime         @default(now())
  remark    String?
  store     Warehouse?       @relation(fields: [storeId], references: [id])
  user      User             @relation(fields: [userId], references: [id])
  vehicle   Vehicle          @relation(fields: [vehicleId], references: [id])
  items     StockAuditItem[]

  @@index([tenantId])
  @@index([storeId])
  @@index([vehicleId])
  @@index([userId])
}

model StockAuditItem {
  id          String     @id @default(cuid())
  auditId     String
  productId   String
  oldQuantity Int
  newQuantity Int
  tenantId    String     @default("VK001")
  audit       StockAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  product     Product    @relation(fields: [productId], references: [id])

  @@index([auditId])
  @@index([productId])
  @@index([tenantId])
}

model DamageEntry {
  id                  String               @id @default(cuid())
  displayId           String?
  tenantId            String               @default("VK001")
  storeId             String?
  vehicleId           String?
  reportedById        String
  productId           String
  quantity            Int
  damageType          DamageType
  selfResponsibility  SelfResponsibility   @default(UNKNOWN)
  reason              String
  images              String[]
  geoLatitude         Float?
  geoLongitude        Float?
  status              DamageStatus         @default(PENDING)
  adminResponsibility AdminResponsibility?
  reviewedById        String?
  reviewedAt          DateTime?
  adminRemarks        String?
  purchaseCost        Float?
  totalLoss           Float?
  stockAdjusted       Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deduction           DamageDeduction?
  product             Product              @relation(fields: [productId], references: [id])
  reportedBy          User                 @relation("DamageReporter", fields: [reportedById], references: [id])
  reviewedBy          User?                @relation("DamageReviewer", fields: [reviewedById], references: [id])
  store               Warehouse?           @relation(fields: [storeId], references: [id])
  vehicle             Vehicle?             @relation(fields: [vehicleId], references: [id])

  @@unique([tenantId, displayId])
  @@index([tenantId])
  @@index([storeId])
  @@index([vehicleId])
  @@index([reportedById])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
  @@index([damageType])
}

model DamageDeduction {
  id              String        @id @default(cuid())
  tenantId        String        @default("VK001")
  storeId         String?
  damageEntryId   String        @unique
  userId          String
  mode            DeductionMode @default(FULL)
  percentage      Float?        @default(100)
  deductionAmount Float         @default(0)
  month           String
  status          String        @default("PENDING")
  appliedById     String?
  appliedAt       DateTime?
  remarks         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appliedBy       User?         @relation("DeductionApplier", fields: [appliedById], references: [id])
  damageEntry     DamageEntry   @relation(fields: [damageEntryId], references: [id])
  store           Warehouse?    @relation(fields: [storeId], references: [id])
  user            User          @relation("DeductionTarget", fields: [userId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([userId])
  @@index([damageEntryId])
  @@index([month])
  @@index([status])
}

model VillageActivity {
  id          String    @id @default(cuid())
  tenantId    String    @default("VK001")
  userId      String
  shiftLogId  String
  villageId   String?
  villageName String
  startTime   DateTime  @default(now())
  endTime     DateTime?
  startLat    Float
  startLong   Float
  endLat      Float?
  endLong     Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  subLocation String?
  shiftLog    ShiftLog  @relation(fields: [shiftLogId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])
  village     Village?  @relation(fields: [villageId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([shiftLogId])
}

model Customer {
  id            String          @id @default(cuid())
  name          String
  mobile        String
  address       String?
  villageId     String?
  tenantId      String          @default("VK001")
  storeId       String?
  creditBalance Float           @default(0)
  loyaltyPoints Int             @default(0)
  segment       CustomerSegment @default(REGULAR)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  isOnline      Boolean         @default(false)
  store         Warehouse?      @relation(fields: [storeId], references: [id])
  village       Village?        @relation(fields: [villageId], references: [id])
  orders        Order[]

  @@unique([tenantId, mobile])
  @@index([tenantId])
  @@index([storeId])
  @@index([villageId])
  @@index([mobile])
}

model Shift {
  id        String @id @default(cuid())
  name      String
  startTime String
  endTime   String
  tenantId  String @default("VK001")
  users     User[]

  @@index([tenantId])
}

model ShiftLog {
  id             String            @id @default(cuid())
  tenantId       String            @default("VK001")
  storeId        String?
  userId         String
  vehicleId      String?
  date           String
  shift          Int               @default(1)
  startTime      DateTime          @default(now())
  endTime        DateTime?
  startLat       Float
  startLong      Float
  startFacePhoto String?
  endLat         Float?
  endLong        Float?
  status         String            @default("STARTED")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  store          Warehouse?        @relation(fields: [storeId], references: [id])
  user           User              @relation(fields: [userId], references: [id])
  activities     VillageActivity[]

  @@index([tenantId])
  @@index([userId])
  @@index([date])
  @@index([storeId])
}

model Attendance {
  id                String           @id @default(cuid())
  userId            String
  tenantId          String           @default("VK001")
  storeId           String?
  date              String
  punchInTime       DateTime
  punchOutTime      DateTime?
  status            AttendanceStatus @default(ACTIVE)
  punchInLat        Float?
  punchInLng        Float?
  punchOutLat       Float?
  punchOutLng       Float?
  totalHours        Float?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  punchInPhoto      String?
  punchOutPhoto     String?
  punchInLocation   String?
  punchOutLocation  String?
  exceptionId       String?
  graceApplied      Int?
  isLate            Boolean          @default(false)
  lateEntryConfigId String?
  lateMinutes       Int?
  shiftStartTime    String?
  lateEntryConfig   LateEntryConfig? @relation(fields: [lateEntryConfigId], references: [id])
  store             Warehouse?       @relation(fields: [storeId], references: [id])
  user              User             @relation(fields: [userId], references: [id])
  lateEntry         LateEntry?

  @@unique([userId, date])
  @@index([tenantId])
  @@index([userId])
  @@index([date])
  @@index([storeId])
}

model LateEntry {
  id             String              @id @default(cuid())
  tenantId       String              @default("VK001")
  storeId        String?
  userId         String
  attendanceId   String              @unique
  configId       String?
  date           String
  shiftStart     String
  checkinTime    DateTime
  lateMinutes    Int
  monthlyCount   Int
  penaltyApplied String              @default("NONE")
  penaltyValue   Float               @default(0)
  isWaived       Boolean             @default(false)
  waivedById     String?
  waivedReason   String?
  notified       Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  attendance     Attendance          @relation(fields: [attendanceId], references: [id])
  config         LateEntryConfig?    @relation(fields: [configId], references: [id])
  store          Warehouse?          @relation(fields: [storeId], references: [id])
  user           User                @relation(fields: [userId], references: [id])
  exception      LateEntryException?

  @@index([tenantId])
  @@index([userId])
  @@index([date])
  @@index([storeId])
}

model LateEntryException {
  id           String    @id @default(cuid())
  tenantId     String    @default("VK001")
  lateEntryId  String    @unique
  userId       String
  reason       String
  description  String?
  status       String    @default("PENDING")
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  approvedBy   User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  lateEntry    LateEntry @relation(fields: [lateEntryId], references: [id])
  user         User      @relation("UserExceptions", fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([status])
}

model LateEntryConfig {
  id          String       @id @default(cuid())
  tenantId    String       @default("VK001")
  storeId     String?
  scope       String       @default("COMPANY")
  scopeValue  String?
  graceMins   Int          @default(10)
  penaltyType String       @default("COUNT")
  rules       Json
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendances Attendance[]
  lateEntries LateEntry[]
  store       Warehouse?   @relation(fields: [storeId], references: [id])

  @@index([tenantId])
  @@index([storeId])
}

model LeaveBalance {
  id          String   @id @default(cuid())
  tenantId    String   @default("VK001")
  userId      String
  month       String
  annualLeave Float    @default(0)
  sickLeave   Float    @default(0)
  casualLeave Float    @default(0)
  lopDays     Float    @default(0)
  halfDays    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, month])
  @@index([tenantId])
}

model BankDeposit {
  id           String    @id @default(cuid())
  tenantId     String    @default("VK001")
  storeId      String
  date         String
  dateTime     DateTime  @default(now())
  amount       Float
  branchName   String
  receiptImage String?
  depositedBy  String
  adminId      String?
  remark       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  admin        User?     @relation(fields: [adminId], references: [id])
  store        Warehouse @relation(fields: [storeId], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([date])
}

model ActivityLog {
  id           String     @id @default(cuid())
  tenantId     String     @default("VK001")
  userId       String
  action       String
  details      String?
  metadata     Json?
  createdAt    DateTime   @default(now())
  storeId      String?
  targetUserId String?
  store        Warehouse? @relation(fields: [storeId], references: [id])
  targetUser   User?      @relation("TargetActions", fields: [targetUserId], references: [id])
  user         User       @relation("UserActions", fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@index([storeId])
}

model LocationLog {
  id          String   @id @default(cuid())
  tenantId    String   @default("VK001")
  userId      String
  lat         Float
  long        Float
  accuracy    Float?
  subLocation String?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([timestamp])
}

model SuspendedSale {
  id             String   @id @default(uuid())
  storeId        String?
  terminalId     String?
  customerName   String?
  customerMobile String?
  totalAmount    Float
  items          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Vendor {
  id               String               @id @default(cuid())
  storeId          String?
  vendorName       String
  mobile           String               @unique
  email            String?
  address          String?
  gstNumber        String?
  contactPerson    String?
  creditDays       Int                  @default(30)
  openingBalance   Float                @default(0)
  currentBalance   Float                @default(0)
  status           VendorStatus         @default(ACTIVE)
  paymentTerms     String?
  creditLimit      Float?               @default(0)
  bankName         String?
  accountNumber    String?
  ifscCode         String?
  bankBranch       String?
  vendorCategory   String?
  minOrderQty      Int                  @default(1)
  approvalStatus   VendorApprovalStatus @default(PENDING)
  isTaxable        Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  displayId        String?              @unique
  purchaseInvoices PurchaseInvoice[]
  purchaseOrders   PurchaseOrder[]
  store            Store?               @relation(fields: [storeId], references: [id])
  itemMappings     VendorItemMapping[]
  ledgerEntries    VendorLedger[]
  payments         VendorPayment[]

  @@index([storeId])
  @@index([status])
}

model VendorItemMapping {
  id               String               @id @default(cuid())
  storeId          String?
  vendorId         String
  productId        String
  vendorSku        String?
  purchasePrice    Float                @default(0)
  moq              Int                  @default(1)
  leadTime         Int                  @default(0)
  taxPercent       Float                @default(0)
  lastPurchaseRate Float                @default(0)
  isPreferred      Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt
  product          Product              @relation(fields: [productId], references: [id])
  store            Store?               @relation(fields: [storeId], references: [id])
  vendor           Vendor               @relation(fields: [vendorId], references: [id])
  priceHistory     VendorPriceHistory[]

  @@unique([vendorId, productId])
  @@index([storeId])
  @@index([vendorId])
  @@index([productId])
}

model VendorPriceHistory {
  id        String            @id @default(cuid())
  mappingId String
  oldPrice  Float
  newPrice  Float
  changedAt DateTime          @default(now())
  mapping   VendorItemMapping @relation(fields: [mappingId], references: [id], onDelete: Cascade)

  @@index([mappingId])
}

model PurchaseOrder {
  id               String                    @id @default(cuid())
  storeId          String?
  poNumber         Int                       @unique @default(autoincrement())
  vendorId         String
  poDate           DateTime                  @default(now())
  expectedDelivery DateTime?
  remarks          String?
  status           POStatus                  @default(CREATED)
  totalAmount      Float                     @default(0)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  displayId        String?                   @unique
  goodsReceipts    ProcurementGoodsReceipt[]
  purchaseInvoices PurchaseInvoice[]
  store            Store?                    @relation(fields: [storeId], references: [id])
  vendor           Vendor                    @relation(fields: [vendorId], references: [id])
  items            PurchaseOrderItem[]

  @@index([storeId])
  @@index([vendorId])
  @@index([status])
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  poId        String
  productId   String
  quantity    Int
  rate        Float
  total       Float         @default(0)
  receivedQty Int           @default(0)
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id])

  @@index([poId])
  @@index([productId])
}

model ProcurementGoodsReceipt {
  id               String                        @id @default(cuid())
  storeId          String?
  poId             String
  grnDate          DateTime                      @default(now())
  status           ProcurementGRNStatus          @default(PARTIAL)
  remarks          String?
  createdAt        DateTime                      @default(now())
  displayId        String?                       @unique
  po               PurchaseOrder                 @relation(fields: [poId], references: [id])
  store            Store?                        @relation(fields: [storeId], references: [id])
  items            ProcurementGoodsReceiptItem[]
  purchaseInvoices PurchaseInvoice[]

  @@index([storeId])
  @@index([poId])
}

model ProcurementGoodsReceiptItem {
  id           String                  @id @default(cuid())
  grnId        String
  productId    String
  orderedQty   Int
  receivedQty  Int
  qcRemarks    String?
  qcStatus     QCStatus                @default(PENDING)
  damagedQty   Int                     @default(0)
  missingQty   Int                     @default(0)
  expiryStatus String?
  grn          ProcurementGoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  product      Product                 @relation(fields: [productId], references: [id])

  @@index([grnId])
  @@index([productId])
}

model PurchaseInvoice {
  id                 String                    @id @default(cuid())
  storeId            String?
  vendorId           String
  poId               String?
  grnId              String?
  invoiceNumber      String                    @unique
  invoiceDate        DateTime                  @default(now())
  dueDate            DateTime?
  transportCharges   Float                     @default(0)
  otherCharges       Float                     @default(0)
  totalAmount        Float                     @default(0)
  status             PurchaseInvoiceStatus     @default(DRAFT)
  paidAmount         Float                     @default(0)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @default(now()) @updatedAt
  displayId          String?                   @unique
  grn                ProcurementGoodsReceipt?  @relation(fields: [grnId], references: [id])
  po                 PurchaseOrder?            @relation(fields: [poId], references: [id])
  store              Store?                    @relation(fields: [storeId], references: [id])
  vendor             Vendor                    @relation(fields: [vendorId], references: [id])
  items              PurchaseInvoiceItem[]
  payments           VendorPayment[]
  paymentAllocations VendorPaymentAllocation[]

  @@index([storeId])
  @@index([vendorId])
  @@index([poId])
  @@index([status])
}

model PurchaseInvoiceItem {
  id                     String          @id @default(cuid())
  invoiceId              String
  productId              String
  quantity               Int
  price                  Float
  total                  Float           @default(0)
  discountPercent        Float           @default(0)
  expDate                DateTime?
  mfgDate                DateTime?
  netCost                Float           @default(0)
  profitMargin           Float           @default(0)
  subtotalBeforeTax      Float           @default(0)
  taxPercent             Float?          @default(0)
  taxType                String?
  unitCostBeforeDiscount Float           @default(0)
  unitCostBeforeTax      Float           @default(0)
  unitSellingPrice       Float           @default(0)
  invoice                PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product                Product         @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model ProcurementStockLedger {
  id           String            @id @default(cuid())
  storeId      String?
  productId    String
  type         StockMovementType
  quantity     Int
  reference    String?
  refType      String?
  balanceAfter Int               @default(0)
  createdAt    DateTime          @default(now())
  product      Product           @relation(fields: [productId], references: [id])
  store        Store?            @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model VendorLedger {
  id          String           @id @default(cuid())
  storeId     String?
  vendorId    String
  date        DateTime         @default(now())
  type        VendorLedgerType
  debit       Float            @default(0)
  credit      Float            @default(0)
  balance     Float            @default(0)
  reference   String?
  description String?
  createdAt   DateTime         @default(now())
  store       Store?           @relation(fields: [storeId], references: [id])
  vendor      Vendor           @relation(fields: [vendorId], references: [id])

  @@index([storeId])
  @@index([vendorId])
  @@index([date])
  @@index([type])
}

model VendorPayment {
  id          String                    @id @default(cuid())
  storeId     String?
  vendorId    String
  paymentDate DateTime                  @default(now())
  amount      Float
  mode        VendorPaymentMode
  referenceNo String?
  isAdvance   Boolean                   @default(false)
  remarks     String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  displayId   String?
  invoiceId   String?
  invoice     PurchaseInvoice?          @relation(fields: [invoiceId], references: [id])
  store       Store?                    @relation(fields: [storeId], references: [id])
  vendor      Vendor                    @relation(fields: [vendorId], references: [id])
  allocations VendorPaymentAllocation[]

  @@index([storeId])
  @@index([vendorId])
  @@index([paymentDate])
}

model VendorPaymentAllocation {
  id        String          @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Float
  createdAt DateTime        @default(now())
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id])
  payment   VendorPayment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([invoiceId])
}

model PurchaseRequisition {
  id        String                    @id @default(cuid())
  storeId   String?
  reqNumber Int                       @unique @default(autoincrement())
  reqDate   DateTime                  @default(now())
  status    RequisitionStatus         @default(PENDING)
  priority  String                    @default("NORMAL")
  remarks   String?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  store     Store?                    @relation(fields: [storeId], references: [id])
  items     PurchaseRequisitionItem[]

  @@index([storeId])
  @@index([status])
}

model PurchaseRequisitionItem {
  id            String              @id @default(cuid())
  requisitionId String
  productId     String
  quantity      Int
  product       Product             @relation(fields: [productId], references: [id])
  requisition   PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId])
  @@index([productId])
}

model ProcurementStockTransfer {
  id              String                         @id @default(cuid())
  transferNumber  Int                            @unique @default(autoincrement())
  fromStoreId     String?
  toStoreId       String?
  fromWarehouseId String?
  toWarehouseId   String?
  transferDate    DateTime                       @default(now())
  status          ProcurementTransferStatus      @default(DRAFT)
  remarks         String?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  items           ProcurementStockTransferItem[]

  @@index([status])
}

model ProcurementStockTransferItem {
  id         String                   @id @default(cuid())
  transferId String
  productId  String
  quantity   Int
  product    Product                  @relation(fields: [productId], references: [id])
  transfer   ProcurementStockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([productId])
}


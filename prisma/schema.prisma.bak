}

model WarehouseEmployee {
  id          String    @id @default(uuid())
  warehouseId String
  name        String
  role        String
  shift       String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

model WarehouseAsset {
  id              String    @id @default(uuid())
  warehouseId     String
  assetId         String    @unique
  name            String
  status          String    @default("OPERATIONAL")
  maintenanceDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

model WarehouseAudit {
  id          String    @id @default(uuid())
  warehouseId String
  auditType   String
  findings    String?
  status      String    @default("OPEN")
  resolution  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

model WarehouseTransfer {
  id            String    @id @default(uuid())
  warehouseId   String
  transferType  String
  entityId      String
  destinationId String?
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

model MobileStoreShift {
  id            String      @id @default(uuid())
  mobileStoreId String
  shiftName     String
  driverId      String?
  salesStaffId  String?
  startTime     DateTime?
  endTime       DateTime?
  status        String      @default("SCHEDULED")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  driver        User?       @relation("ShiftDriver", fields: [driverId], references: [id])
  mobileStore   MobileStore @relation(fields: [mobileStoreId], references: [id], onDelete: Cascade)
  salesStaff    User?       @relation("ShiftSalesStaff", fields: [salesStaffId], references: [id])
}

model MobileStoreRouteExecution {
  id             String      @id @default(uuid())
  mobileStoreId  String
  routeId        String?
  status         String      @default("PLANNED")
  assignedRoute  String?
  startedAt      DateTime?
  completedAt    DateTime?
  currentStop    String?
  completedStops Int         @default(0)
  pendingStops   Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  mobileStore    MobileStore @relation(fields: [mobileStoreId], references: [id], onDelete: Cascade)
}

model MobileStoreVillageCoverage {
  id            String      @id @default(uuid())
  mobileStoreId String
  district      String
  mandal        String
  village       String
  pincode       String
  status        String      @default("ACTIVE")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  mobileStore   MobileStore @relation(fields: [mobileStoreId], references: [id], onDelete: Cascade)
}

model MobileStoreInventoryMovement {
  id            String      @id @default(uuid())
  mobileStoreId String
  productId     String?
  variantId     String?
  movementType  String
  quantity      Int
  referenceId   String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  mobileStore   MobileStore @relation(fields: [mobileStoreId], references: [id], onDelete: Cascade)
}

model MobileStoreFuelLog {
  id                String      @id @default(uuid())
  mobileStoreId     String
  fuelFilled        Float
  fuelCost          Float
  mileageAtFill     Float?
  distanceTravelled Float?
  date              DateTime    @default(now())
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  mobileStore       MobileStore @relation(fields: [mobileStoreId], references: [id], onDelete: Cascade)
}

model MobileStoreIncident {
  id              String      @id @default(uuid())
  mobileStoreId   String
  incidentType    String
  description     String
  status          String      @default("OPEN")
  reportedAt      DateTime    @default(now())
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  mobileStore     MobileStore @relation(fields: [mobileStoreId], references: [id], onDelete: Cascade)
}

model MobileStoreApproval {
  id            String      @id @default(uuid())
  mobileStoreId String
  approvalType  String
  details       Json?
  status        String      @default("PENDING")
  requestedBy   String?
  approvedBy    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  mobileStore   MobileStore @relation(fields: [mobileStoreId], references: [id], onDelete: Cascade)
}

model WarehouseReturn {
  id          String    @id @default(uuid())
  warehouseId String
  orderId     String?
  reason      String
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

model FulfillmentOrder {
  id                  String                  @id @default(uuid())
  fulfillmentOrderNo  String                  @unique
  orderId             String
  status              FulfillmentOrderStatus  @default(ALLOCATED)
  fulfillmentType     FulfillmentType         @default(HOME_DELIVERY)
  assignedStoreId     String?
  assignedWarehouseId String?
  assignedVehicleId   String?
  assignedDriverId    String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  assignments         FulfillmentAssignment[]
  order               Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items               FulfillmentOrderItem[]
  fulfillmentSLA      FulfillmentSLA?
  reservations        InventoryReservation[]
  settlements         Settlement[]

  @@index([orderId])
  @@index([status])
}

model FulfillmentOrderItem {
  id                 String           @id @default(uuid())
  fulfillmentOrderId String
  productId          String
  productVariantId   String?
  quantity           Int
  productName        String
  sku                String?
  unitPrice          Float
  discountAmount     Float            @default(0)
  taxAmount          Float            @default(0)
  totalPrice         Float
  fulfillmentOrder   FulfillmentOrder @relation(fields: [fulfillmentOrderId], references: [id], onDelete: Cascade)
  product            Product          @relation(fields: [productId], references: [id])
  productVariant     ProductVariant?  @relation(fields: [productVariantId], references: [id])

  @@index([fulfillmentOrderId])
  @@index([productId])
}

model FulfillmentAssignment {
  id                 String                      @id @default(uuid())
  fulfillmentOrderId String
  driverId           String
  status             FulfillmentAssignmentStatus @default(PENDING)
  assignedAt         DateTime                    @default(now())
  acknowledgedAt     DateTime?
  completedAt        DateTime?
  driver             User                        @relation(fields: [driverId], references: [id])
  fulfillmentOrder   FulfillmentOrder            @relation(fields: [fulfillmentOrderId], references: [id], onDelete: Cascade)

  @@index([fulfillmentOrderId])
  @@index([driverId])
}

model InventoryLedger {
  id               String                @id @default(uuid())
  productId        String
  productVariantId String?
  locationId       String
  quantity         Int
  transactionType  LedgerTransactionType
  referenceId      String?
  notes            String?
  createdAt        DateTime              @default(now())
  location         InventoryLocation     @relation(fields: [locationId], references: [id])
  product          Product               @relation(fields: [productId], references: [id])
  productVariant   ProductVariant?       @relation(fields: [productVariantId], references: [id])

  @@index([productId])
  @@index([productVariantId])
  @@index([locationId])
  @@index([createdAt])
}

model PaymentTransaction {
  id             String                   @id @default(uuid())
  orderId        String
  transactionRef String?                  @unique
  amount         Float
  paymentMethod  PaymentMethod?
  status         PaymentTransactionStatus @default(PENDING)
  payload        Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  order          Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model RiskAssessment {
  id         String   @id @default(uuid())
  orderId    String   @unique
  score      Float
  isFlagged  Boolean  @default(false)
  reasons    String[] @default([])
  assessedAt DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CashSession {

  subCategory         SubCategory                       @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  warehouseCategory   WarehouseCategory                 @relation(fields: [warehouseCategoryId], references: [id], onDelete: Cascade)
  warehouse           Warehouse                         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, warehouseCategoryId, subCategoryId])
  @@index([warehouseId])
  @@index([warehouseCategoryId])
  @@index([subCategoryId])
  @@index([warehouseId, isEnabled])
  @@index([warehouseCategoryId, isEnabled])
}


  mobileStore   MobileStore @relation(fields: [mobileStoreId], references: [id], onDelete: Cascade)
}

model Module {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String           @unique @db.VarChar(100)
  status      Status           @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  channel   String[]
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model NotificationDispatchLog {
  id              String   @id @default(uuid())
  idempotencyKey  String?  @unique
  type            String
  recipientUserId String?
  orderId         String?
  payload         Json?
  status          String
  fcmMessageId    String?
  error           String?
  correlationId   String?
  sourceService   String?
  createdAt       DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([type, status, createdAt])
}

model NotificationQueueLog {
  id          String    @id @default(uuid())
  jobId       String
  jobName     String
  status      String
  payload     Json?
  error       String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([jobName, createdAt])
  @@index([status, createdAt])
}

model OfferImage {
  id        String         @id @default(uuid())
  name      String
  type      OfferImageType
  image     String
  status    Status         @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model OpeningCash {
  id               String     @id @default(cuid())
  vehicleId        String
  userId           String
  date             String
  denominations    Json
  totalOpeningCash Float
  status           String     @default("SUBMITTED")
  createdAt        DateTime   @default(now())
  tenantId         String     @default("VK001")
  shift            Int        @default(1)
  isNoService      Boolean    @default(false)
  storeId          String?
  store            Warehouse? @relation(fields: [storeId], references: [id])
  user             User       @relation(fields: [userId], references: [id])
  vehicle          Vehicle    @relation(fields: [vehicleId], references: [id])

  @@unique([vehicleId, date, shift])
  @@index([tenantId])
  @@index([storeId])
}

model Order {
  id                                              String                    @id @default(uuid())

  @@index([status])
}

model PriceBook {
  id           String         @id
  name         String
  code         String         @unique
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime
  ProductPrice ProductPrice[]

  @@index([code])
}

model ProductPrice {
  id               String          @id
  productId        String
  productVariantId String?
  priceBookId      String
  mrp              Float
  sellingPrice     Float
  effectiveFrom    DateTime        @default(now())
  effectiveTo      DateTime?
  createdAt        DateTime        @default(now())

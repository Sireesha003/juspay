  addressId                                       String?
  warehouseId                                     String?
  status                                          OrderStatus               @default(PENDING)
  totalAmount                                     Float
  deliveryCharge                                  Float                     @default(0)
  discount                                        Float                     @default(0)
  deliverySlot                                    String?
  deliverySlotId                                  String?
  deliveryDate                                    DateTime?
  specialInstructions                             String?
  createdAt                                       DateTime                  @default(now())
  updatedAt                                       DateTime                  @updatedAt
  confirmedAt                                     DateTime?
  agentId                                         String?
  otp                                             String?
  consumerId                                      String
  couponCode                                      String?
  couponDiscount                                  Float?
  couponId                                        String?                   @db.Uuid
  cancellationFee                                 Float                     @default(0)
  cancellationReason                              String?
  cancelledAt                                     DateTime?
  cancelledBy                                     String?
  cgst                                            Float                     @default(0)
  igst                                            Float                     @default(0)
  sgst                                            Float                     @default(0)
  taxAmount                                       Float                     @default(0)
  taxableAmount                                   Float                     @default(0)
  deliveryDistance                                Float?
  deliveryType                                    DeliveryType?
  fastDeliveryETA                                 Int?
  pickupStoreId                                   String?
  pickupTimeSlot                                  String?
  assignedAt                                      DateTime?
  pickedUpAt                                      DateTime?
  deliveredAt                                     DateTime?
  failureReason                                   String?
  otpExpiresAt                                    DateTime?
  pickupSlotId                                    String?
  routeMapId                                      String?
  scheduledSlotId                                 String?
  cartType                                        CartType                  @default(SINGLE)
  assignmentDueAt                                 DateTime?
  assignmentAcknowledgedAt                        DateTime?
  customerId                                      String?
  routeId                                         String?
  vehicleId                                       String?
  paymentMode                                     PaymentMode?
  cashAmount                                      Float?                    @default(0)
  upiAmount                                       Float?                    @default(0)
  fulfillmentType                                 FulfillmentType           @default(HOME_DELIVERY)
  mobileStoreId                                   String?
  orderType                                       OmsOrderType              @default(ONLINE)
  sourceOrderId                                   String?
  paymentStatus                                   String                    @default("PENDING")
  paymentMethod                                   String?
  transactionId                                   String?
  allocatedWarehouseId                            String?
  allocatedStoreId                                String?
  acceptedByShopkeeperAt                          DateTime?
  allocationAttempts                              Int?                      @default(0)
  allocationStartedAt                             DateTime?
  allocationStatus                                String?                   @default("Pending")
  allocationTimeoutMinutes                        Int?                      @default(5)
  assignedShopkeeperId                            String?
  packerId                                        String?
  packingCompletedAt                              DateTime?
  packingStartedAt                                DateTime?
  pickerId                                        String?
  pickingCompletedAt                              DateTime?
  pickingStartedAt                                DateTime?
  priority                                        String?                   @default("MEDIUM")
  shopkeeperAcceptedAt                            DateTime?
  slaBreach                                       Boolean                   @default(false)
  slaMinutes                                      Int?                      @default(30)
  trayNumber                                      String?
  agentCashCollections                            AgentCashCollection[]
  chats                                           Chat[]
  couponRedemptions                               CouponRedemption[]
  delivery                                        Delivery?
  deliveryAssignment                              DeliveryAssignment?
  deliveryAttempts                                DeliveryAttempt[]
  deliveryLocationHistory                         DeliveryLocationHistory[]
  FulfillmentOrder                                FulfillmentOrder[]
  inventoryReservations                           InventoryReservation[]
  address                                         Address?                  @relation(fields: [addressId], references: [id])
  agent                                           User?                     @relation("AgentOrders", fields: [agentId], references: [id])
  Store                                           Store?                    @relation(fields: [allocatedStoreId], references: [id])
  Warehouse_Order_allocatedWarehouseIdToWarehouse Warehouse?                @relation("Order_allocatedWarehouseIdToWarehouse", fields: [allocatedWarehouseId], references: [id])
  Shopkeeper                                      Shopkeeper?               @relation(fields: [assignedShopkeeperId], references: [id])
  consumer                                        User                      @relation("ConsumerOrders", fields: [consumerId], references: [id])
  coupon                                          Coupon?                   @relation(fields: [couponId], references: [id])
  customer                                        Customer?                 @relation(fields: [customerId], references: [id])
  deliverySlotRef                                 DeliverySlot?             @relation(fields: [deliverySlotId], references: [id])
  mobileStore                                     MobileStore?              @relation(fields: [mobileStoreId], references: [id])
  pickupSlotRef                                   PickupSlot?               @relation(fields: [pickupSlotId], references: [id])
  pickupStore                                     Warehouse?                @relation("PickupStore", fields: [pickupStoreId], references: [id])
